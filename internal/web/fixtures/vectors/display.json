        {"req": "PUT /display/settings", "body": {"virtual_connector": ""}, "expect": {"status": 400}},
        {"req": "PUT /display/settings", "body": {"virtual_connector": "DP-3", "hdr": true}, "expect": {"status": 200}},
        {"req": "GET /display", "passive": true, "expect": {"body": {"virtual_connector": "DP-3", "available_connectors": ["DP-1", "DP-2"], "reboot_needed": true, "hdr": true}}},
        {"req": "PUT /display/settings", "body": {"virtual_connector": "HDMI-A-1"}, "expect": {"status": 200}},
        {"req": "GET /display", "passive": true, "expect": {"body": {"available_connectors": ["DP-1", "DP-2", "DP-3"]}}},
        {"req": "PUT /display/settings", "body": {"hdr": "yes"}, "expect": {"status": 400}}
      ]
    },
    {
      "name": "display-no-gpu",
      "preset": "no-gpu",
      "steps": [
        {"req": "GET /display", "passive": true},
        {"req": "PUT /display/settings", "body": {"virtual_connector": "DP-2"}, "expect": {"status": 409, "body": {"error": "no supported GPU for a virtual display"}, "copy": "Needs a supported graphics card."}},
        {"req": "PUT /display/settings", "body": {"hdr": true}, "expect": {"status": 200}},
        {"req": "GET /status", "passive": true}
      ]
