# syntax=docker/dockerfile:1
#
# The AUR packages WaterVaporOS needs that Arch does not ship: bootc, bootupd,
# and the libselinux chain bootc links against.
#
# This lives in its own image because compiling bootc is a multi-minute Rust
# build (many times that under qemu emulation) and it only changes when bootc
# does. CI publishes it; the OS build just copies the packages out.
FROM docker.io/library/archlinux:base-devel AS aur

# pacman 7's seccomp sandbox cannot initialise under qemu-user emulation
# ("error restricting syscalls via seccomp: 22"), which is how an x86_64 Arch
# image builds on an arm64 host. The build is already isolated by the container.
RUN echo 'DisableSandbox' >> /etc/pacman.conf

RUN pacman -Syu --noconfirm --needed git rust cargo ostree composefs \
        libcap systemd openssl pkgconf clang \
        flex swig python python-build python-pip python-setuptools ruby xz \
        go-md2man pcre2 && \
    useradd -m build && \
    echo 'build ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/build

COPY scripts/aur-build.sh /usr/local/bin/aur-build

# Arch does not ship SELinux, but bootc links against libselinux, so the whole
# chain comes from the AUR. Order matters: each package is installed before the
# next one configures against it.
USER build
WORKDIR /home/build
RUN aur-build libsepol libselinux bootc bootupd

USER root
RUN mkdir -p /pkgs && cp /home/build/*/*.pkg.tar.zst /pkgs/


FROM scratch
COPY --from=aur /pkgs /pkgs
