#!/usr/bin/env bash
# mkinitcpio install hook: everything the vos runtime hook needs to assemble
# the root filesystem, either from an A/B slot on disk or from the live ISO.

build() {
    add_module erofs
    add_module overlay
    add_module loop
    add_module ext4
    # The ESP, mounted to mark a slot that cannot start as bad. The nls
    # modules are FAT's code page and charset; they may be built in.
    add_module vfat
    add_module 'nls_cp437?'
    add_module 'nls_iso8859-1?'

    # Live boot from optical media or a CD-ROM-emulating hypervisor.
    add_module isofs
    add_module cdrom
    add_module sr_mod
    # Without this rule udev never probes the disc, so /dev/disk/by-label
    # never shows up for the ISO.
    add_udev_rule 60-cdrom_id.rules
    # Live boot from an .iso file on the filesystems Ventoy formats (the hook
    # mounts it from there); vfat is above. exFAT's default charset is UTF-8.
    add_module exfat
    add_module 'ntfs3?'
    add_module 'nls_utf8?'

    add_binary losetup
    add_binary mount
    add_binary umount
    # Checks (and if need be repairs) vos_data before it is mounted.
    add_binary e2fsck
    # util-linux blkid: the GPT disk GUID (PTUUID) that vos.disk names.
    add_binary blkid
    # Finds the live ISO as a file on a Ventoy stick; busybox here has no find.
    add_binary find
    # Extensions: tune2fs turns on ext4's verity feature on vos_data, and
    # fsverity measures each image before it mounts (fsverity-utils).
    add_binary tune2fs
    add_binary fsverity

    add_runscript
}

help() {
    cat <<HELPEOF
Mounts the VaporOS root: a read-only erofs image with /etc overlaid and
/var bind-mounted from the data partition (installed; the partitions are
found on the disk vos.disk= names), or the same image from the ISO under a
tmpfs overlay (live, vos.mode=live), on a written stick, a CD, or as an .iso
file on exFAT, FAT or NTFS (Ventoy). Installed, it lays the extension
images the store holds read-only over /usr once fs-verity vouches for them.
Never opens a shell: failures reboot, and a slot that cannot start is marked
bad so the other one starts next; an extension that cannot mount is skipped.
HELPEOF
}
