#!/usr/bin/ash
# shellcheck shell=dash
#
# VaporOS root assembly.
#
# Installed:  vos.slot=a|b vos.disk=<GPT disk GUID>
#   /            erofs, read-only        partition vos_<slot>
#   /state       ext4, read-write        partition vos_data (e2fsck'd first)
#   /var         bind of /state/var
#   /etc         overlay: image /etc + /state/etc/upper
#   The partitions are found by GPT name on the disk vos.disk names, so a
#   second disk with VaporOS on it is never used. Installs from before
#   vos.disk go by /dev/disk/by-partlabel, on whatever disk has the name.
#
# Live:       vos.mode=live vos.label=VOS_LIVE vos.version=<version>
#   /            overlay: erofs image on the ISO + tmpfs, all changes lost on reboot
#   The ISO is the device labelled vos.label (written to a stick, or a CD),
#   or else an .iso file with that label and the manifest version
#   vos.version on an exFAT, FAT or NTFS partition (Ventoy, which cannot
#   hook into systemd-boot), mounted read-only at /run/vos/host.
#
# VaporOS never shows a shell. Anything that goes wrong here reboots the
# machine instead. A freshly updated slot is on trial, and systemd-boot's
# boot counting falls back to the previous one after three tries; any other
# slot that cannot start is marked bad on the ESP first, so the other slot
# starts next rather than this one forever. The reason goes to the serial
# console and to the screen.

run_hook() {
    vos_mode="$(getarg vos.mode disk)"
    vos_slot="$(getarg vos.slot)"
    vos_disk="$(getarg vos.disk)"
    vos_label="$(getarg vos.label VOS_LIVE)"
    vos_version="$(getarg vos.version)"
    vos_disk_name=""
    slot_dev=""

    export mount_handler="vos_mount_handler"
}

# mkinitcpio calls this right before every emergency shell it would open
# (a failed mount, a missing init, break=...), so none of them ever opens.
run_emergencyhook() {
    vos_reboot "the initramfs could not start the system"
}

vos_serial() {
    # stderr is redirected first, so a ttyS0 without a UART fails silently.
    if [ -c /dev/ttyS0 ]; then
        echo "VaporOS: $*" 2>/dev/null >/dev/ttyS0
    fi
}

# vos_screen: the console is ttyS0 alone, so without this a machine with
# only a monitor shows a blank screen and reboots without a word.
vos_screen() {
    if [ -c /dev/tty1 ]; then
        printf '\nVaporOS: %s\n' "$*" 2>/dev/null >/dev/tty1
    fi
}

vos_reboot() {
    vos_demote
    vos_serial "$* -- rebooting in 5 seconds"
    vos_screen "$* -- rebooting in 5 seconds"
    sleep 5
    reboot -f
    # reboot -f does not return; if it somehow does, ask the kernel directly.
    echo b >/proc/sysrq-trigger
}

vos_die() {
    err "$*"
    vos_reboot "$*"
}

vos_mount_handler() {
    root="$1"
    case "$vos_mode" in
        live) vos_mount_live "$root" ;;
        *)    vos_mount_disk "$root" ;;
    esac
}

# vos_part_on DISK NAME: prints /dev/<partition> for the partition of DISK
# (a kernel name) whose GPT name is NAME, from the kernel's own uevent.
vos_part_on() {
    local p d
    for p in /sys/class/block/"$1"/*/partition; do
        [ -e "$p" ] || continue
        d="${p%/partition}"
        if grep -qx "PARTNAME=$2" "$d/uevent" 2>/dev/null; then
            echo "/dev/${d##*/}"
            return 0
        fi
    done
    return 1
}

# vos_disk_guid DISK: prints the GPT disk GUID of DISK, lowercase.
vos_disk_guid() {
    local g
    g="$(blkid -p -s PTUUID -o value "/dev/$1" 2>/dev/null)"
    [ -n "$g" ] || g="$(udevadm info --query=property --name="/dev/$1" 2>/dev/null | sed -n 's/^ID_PART_TABLE_UUID=//p')"
    echo "$g" | tr 'A-F' 'a-f'
}

# vos_find_disk: prints the kernel name of the disk whose GPT disk GUID is
# vos.disk and that has this slot's partition. Exits 2 when no disk's GUID
# could be read at all: then the tools failed, not the disk.
vos_find_disk() {
    local want d n g read=0
    want="$(echo "$vos_disk" | tr 'A-F' 'a-f')"
    for d in /sys/class/block/*; do
        [ -e "$d/partition" ] && continue
        n="${d##*/}"
        vos_part_on "$n" "vos_${vos_slot}" >/dev/null || continue
        g="$(vos_disk_guid "$n")"
        [ -n "$g" ] && read=1
        if [ "$g" = "$want" ]; then
            echo "$n"
            return 0
        fi
    done
    [ "$read" = 1 ] && return 1
    return 2
}

# vos_wait_disk: waits up to 30 s for the disk vos.disk names and sets
# vos_disk_name. Returns 2 if disk GUIDs cannot be read here at all.
vos_wait_disk() {
    local i=0 rc
    while :; do
        vos_disk_name="$(vos_find_disk)"
        rc=$?
        [ "$rc" = 0 ] && return 0
        [ "$i" -ge 60 ] && return "$rc"
        i=$((i + 1))
        sleep .5
    done
}

# vos_prefer_disk DISK: after switch_root, every /dev/disk/by-partlabel/vos_*
# link must name this disk's partition even when another disk has VaporOS
# on it: fstab mounts /efi by PARTLABEL=vos_esp. A higher link_priority
# wins that link in udev; /run survives switch_root, and the kernel names
# stay the same for the whole boot.
vos_prefer_disk() {
    local p d
    mkdir -p /run/udev/rules.d
    {
        echo "# Written by the VaporOS initramfs: this boot's disk is /dev/$1."
        for p in /sys/class/block/"$1"/*/partition; do
            [ -e "$p" ] || continue
            d="${p%/partition}"
            echo "SUBSYSTEM==\"block\", KERNEL==\"${d##*/}\", OPTIONS+=\"link_priority=100\""
        done
    } >/run/udev/rules.d/61-vos-boot-disk.rules
}

# vos_entry_of FILE SLOT: does loader entry FILE boot SLOT?
vos_entry_of() {
    grep -Eq "^[[:space:]]*options[[:space:]](.*[[:space:]])?vos\.slot=$2([[:space:]]|\$)" "$1" 2>/dev/null
}

# vos_bootable_entry DIR SLOT: has SLOT an entry systemd-boot still boots
# (no boot counter, or tries left)?
vos_bootable_entry() {
    local f
    for f in "$1"/vos-*.conf; do
        [ -f "$f" ] || continue
        vos_entry_of "$f" "$2" || continue
        case "${f##*/}" in
            *+0.conf | *+0-*.conf) continue ;;
        esac
        return 0
    done
    return 1
}

# vos_disk_of PART: prints the kernel name of the disk partition PART is on.
vos_disk_of() {
    local d
    d="$(readlink -f "/sys/class/block/$1")" || return 1
    d="${d%/*}"
    echo "${d##*/}"
}

# vos_esp_dev: prints this boot's ESP: on the vos.disk disk, or, before
# vos.disk, the labelled one only if it shares the slot's disk.
vos_esp_dev() {
    local esp slot
    if [ -n "$vos_disk" ]; then
        [ -n "$vos_disk_name" ] || vos_disk_name="$(vos_find_disk)" || return 1
        vos_part_on "$vos_disk_name" vos_esp
        return
    fi
    [ -n "$slot_dev" ] && [ -b "$slot_dev" ] || return 1
    esp="$(readlink -f /dev/disk/by-partlabel/vos_esp)" && [ -b "$esp" ] || return 1
    slot="$(readlink -f "$slot_dev")" || return 1
    [ "$(vos_disk_of "${esp##*/}")" = "$(vos_disk_of "${slot##*/}")" ] || return 1
    echo "$esp"
}

# vos_demote: marks this boot's entry bad (vos-<ver>+0-1.conf) before a
# reboot, so systemd-boot starts the other slot next. A blessed entry has
# no boot counter: without this, a slot that stops booting would start
# again and again while the other slot's entry sits unused. Only when the
# other slot has an entry that can boot; a counted entry (a trial boot) is
# left to systemd-boot's own counting. Best effort, and silent.
vos_demote() {
    local other esp mnt dir f bad
    [ "$vos_mode" = live ] && return 0
    case "$vos_slot" in
        a) other=b ;;
        b) other=a ;;
        *) return 0 ;;
    esac
    esp="$(vos_esp_dev 2>/dev/null)" && [ -b "$esp" ] || return 0
    mnt=/run/vos/esp
    mkdir -p "$mnt"
    mount -t vfat -o rw,noatime "$esp" "$mnt" 2>/dev/null || return 0
    dir="$mnt/loader/entries"
    if vos_bootable_entry "$dir" "$other"; then
        for f in "$dir"/vos-*.conf; do
            [ -f "$f" ] || continue
            case "${f##*/}" in *+*) continue ;; esac
            vos_entry_of "$f" "$vos_slot" || continue
            bad="${f%.conf}+0-1.conf"
            [ -e "$bad" ] && continue
            mv "$f" "$bad" && vos_serial "marked ${f##*/} bad; slot ${other} starts next"
        done
    fi
    sync
    umount "$mnt" 2>/dev/null
}

# Check the data partition before mounting it: it is the only writable
# filesystem, and power loss is routine for a box that is switched off at the
# wall. -p repairs whatever is safe to repair unattended; anything worse gets
# -y, because nobody is at a console to answer questions. If even that fails,
# mount anyway -- the kernel refuses a filesystem it cannot use, and that ends
# in vos_die.
vos_fsck_data() {
    dev="$1"
    e2fsck -p "$dev"
    rc=$?
    if [ "$rc" -ge 4 ]; then
        msg ":: repairing ${dev} (e2fsck -p exit ${rc})"
        e2fsck -y "$dev"
        rc=$?
    fi
    if [ "$rc" -ge 4 ]; then
        err "e2fsck could not repair ${dev} (exit ${rc}); mounting it anyway"
    fi
}

vos_mount_disk() {
    root="$1"
    [ "$vos_slot" = a ] || [ "$vos_slot" = b ] ||
        vos_die "vos.slot must be 'a' or 'b' (got '${vos_slot}')"

    slot_dev="/dev/disk/by-partlabel/vos_${vos_slot}"
    data_dev="/dev/disk/by-partlabel/vos_data"
    if [ -n "$vos_disk" ]; then
        vos_wait_disk
        case $? in
            0)
                slot_dev="$(vos_part_on "$vos_disk_name" "vos_${vos_slot}")"
                data_dev="$(vos_part_on "$vos_disk_name" vos_data)" ||
                    vos_die "/dev/${vos_disk_name} has no vos_data partition"
                vos_prefer_disk "$vos_disk_name"
                ;;
            2)
                # No disk GUID is readable here: a tool is missing, not the
                # disk. Booting by label beats never booting.
                vos_disk=""
                vos_serial "cannot read GPT disk GUIDs; finding partitions by label"
                ;;
            *)
                vos_die "no disk with GPT disk GUID ${vos_disk} (vos.disk) and a vos_${vos_slot} partition"
                ;;
        esac
    fi

    poll_device "$slot_dev" 30 || vos_die "slot ${vos_slot} not found at ${slot_dev}"
    poll_device "$data_dev" 30 || vos_die "data partition not found at ${data_dev}"

    vos_fsck_data "$data_dev"

    msg ":: mounting VaporOS slot ${vos_slot}"
    mount -t erofs -o ro "$slot_dev" "$root" || vos_die "cannot mount ${slot_dev}"
    mount -t ext4 -o rw,noatime "$data_dev" "$root/state" || vos_die "cannot mount ${data_dev}"

    mkdir -p "$root/state/var" "$root/state/etc/upper" "$root/state/etc/work"
    mount -o bind "$root/state/var" "$root/var" || vos_die "cannot bind /var"
    # index=off: the lower /etc is a different erofs after every A/B switch.
    # With the index on, overlayfs pins the upper layer to the lower it was
    # created on and refuses to mount it on the other slot (ESTALE).
    mount -t overlay overlay \
        -o "lowerdir=$root/etc,upperdir=$root/state/etc/upper,workdir=$root/state/etc/work,index=off" \
        "$root/etc" || vos_die "cannot overlay /etc"
}

# vos_try_medium DEV: mounts DEV at /run/vos/medium if it is this boot's
# ISO: iso9660 with the vos.version manifest (any, without vos.version).
vos_try_medium() {
    mount -t iso9660 -o ro "$1" /run/vos/medium 2>/dev/null || return 1
    if [ -z "$vos_version" ] ||
        grep -Eq "\"version\"[[:space:]]*:[[:space:]]*\"${vos_version}\"" /run/vos/medium/vos/manifest.json 2>/dev/null; then
        return 0
    fi
    umount /run/vos/medium
    return 1
}

# vos_try_iso FILE: attaches FILE and mounts it as the medium if it is
# this boot's ISO. blkid reads the volume label of a plain file.
vos_try_iso() {
    local dev
    [ "$(blkid -p -s LABEL -o value "$1" 2>/dev/null)" = "$vos_label" ] || return 1
    dev="$(losetup -f --show -r "$1")" || return 1
    vos_try_medium "$dev" && return 0
    losetup -d "$dev"
    return 1
}

# vos_scan_part NAME: looks for this boot's ISO as a file on partition NAME,
# mounted read-only at /run/vos/host and left mounted when it is there.
# Only filesystems Ventoy formats and a ro mount leaves alone: ext4 would
# replay its journal even read-only.
vos_scan_part() {
    local dev="/dev/$1" fs
    case "$(blkid -p -s TYPE -o value "$dev" 2>/dev/null)" in
        exfat) fs=exfat ;;
        vfat)  fs=vfat ;;
        ntfs)  fs=ntfs3 ;;
        *)     return 1 ;;
    esac
    mount -t "$fs" -o ro "$dev" /run/vos/host 2>/dev/null || return 1
    if find /run/vos/host -xdev -type f -iname '*.iso' 2>/dev/null | {
        while IFS= read -r f; do
            if vos_try_iso "$f"; then
                vos_serial "live medium is ${f#/run/vos/host} on ${dev}"
                exit 0
            fi
        done
        exit 1
    }; then
        return 0
    fi
    umount /run/vos/host
    return 1
}

# vos_find_live: mounts this boot's ISO at /run/vos/medium, waiting up to
# 30 s for it. The labelled device has the first 3 s to itself, so a
# written stick or a CD is never scanned for. USB partitions come first:
# searching an internal Windows drive can take a while.
vos_find_live() {
    local i=0 d n usb scanned=" "
    mkdir -p /run/vos/medium /run/vos/host
    while :; do
        if [ -b "/dev/disk/by-label/${vos_label}" ] && vos_try_medium "/dev/disk/by-label/${vos_label}"; then
            return 0
        fi
        if [ "$i" -ge 6 ]; then
            for d in /sys/class/block/*; do
                n="${d##*/}"
                case "$n" in loop* | ram* | zram* | sr* | dm-* | md* | nbd*) continue ;; esac
                case "$scanned" in *" $n "*) continue ;; esac
                [ -b "/dev/$n" ] || continue
                case "$(readlink -f "$d")" in */usb*) usb=1 ;; *) usb=0 ;; esac
                [ "$usb" = 1 ] || [ "$i" -ge 20 ] || continue
                scanned="${scanned}${n} "
                vos_scan_part "$n" && return 0
            done
        fi
        [ "$i" -ge 60 ] && return 1
        i=$((i + 1))
        sleep .5
    done
}

vos_mount_live() {
    root="$1"
    base=/run/vos

    vos_find_live ||
        vos_die "live medium not found: no ${vos_label} device and no ${vos_label} .iso file on an exFAT, FAT or NTFS partition"

    msg ":: mounting VaporOS live medium"
    mkdir -p "$base/lower" "$base/cow"

    loopdev="$(losetup -f --show -r "$base/medium/vos/root.erofs")" ||
        vos_die "cannot attach root.erofs"
    mount -t erofs -o ro "$loopdev" "$base/lower" || vos_die "cannot mount root.erofs"

    mount -t tmpfs -o mode=0755,size=75% cow "$base/cow" || vos_die "cannot mount the live tmpfs"
    mkdir -p "$base/cow/upper" "$base/cow/work"
    mount -t overlay overlay \
        -o "lowerdir=$base/lower,upperdir=$base/cow/upper,workdir=$base/cow/work" \
        "$root" || vos_die "cannot assemble live root"

    # Everything below is written into the throwaway overlay, so it can never
    # leak into an installed system.

    # The installer is a web page (vosd + the welcome screen show where), so
    # the live session has no login anywhere -- except that debug images get
    # a root shell on the serial console, as installed debug images do, for
    # the dev loop.
    if grep -Eq '"debug"[[:space:]]*:[[:space:]]*true' "$base/lower/usr/lib/vos/image.json" 2>/dev/null; then
        unit=serial-getty@ttyS0.service
        mkdir -p "$root/etc/systemd/system/${unit}.d" "$root/etc/systemd/system/getty.target.wants"
        cat >"$root/etc/systemd/system/${unit}.d/autologin.conf" <<UNIT
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin root --noclear --keep-baud %I 115200,38400,9600 \$TERM
UNIT
        rm -f "$root/etc/systemd/system/serial-getty@.service"
        ln -sf /usr/lib/systemd/system/serial-getty@.service \
            "$root/etc/systemd/system/getty.target.wants/${unit}"
    fi

    # There is no ESP to automount in a live session. Left in, the automount
    # is triggered by every sandboxed service's mount namespace and fails
    # them all after a 90s device timeout (D-Bus first).
    sed -i '/vos_esp/d' "$root/etc/fstab"
    # What the welcome screen and mDNS announce: http://vaporos-setup.local
    echo vaporos-setup > "$root/etc/hostname"
}
