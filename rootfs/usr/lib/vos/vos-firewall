#!/usr/bin/bash
# Load the VaporOS firewall: the fixed ruleset in nftables.nft, plus the ports
# that /var/lib/vos/config.json switches on. vos-firewall.service runs this at
# boot and on `systemctl reload vos-firewall`, which is how vosd applies a
# changed setting.
#
#   vos-firewall            load the rules
#   vos-firewall --check    check them with nft -c; change nothing
#   vos-firewall --print    print what would be loaded
#
#   config.json          opens
#   ssh.enabled          tcp 22 from the local network
#   web.https            tcp 443 from the local network (like port 80)
#   web.allow_public     tcp 80 (443 with https, 22 with ssh) from anywhere
#
# and the ports of the extensions this boot runs, which vosd lists in
# /var/lib/vos/ext/ports (one "tcp PORT", "udp PORT" or "tcp PORT upstream
# UPSTREAM" line each, both 1024-65535 and never a reserved port: 47990,
# Sunshine's admin port, or 31911, Steam's debugger). Those are opened to
# the local network only, whatever web.allow_public says; one line that is
# not exactly that, or more than 64, and the file opens nothing. An
# UPSTREAM is the loopback port vosd proxies PORT to: only root (vosd) may
# connect to it.
#
# VOS_NFT_RULES, VOS_CONFIG and VOS_EXT_PORTS override the three input
# paths (the build uses them to check the rules against test files).
set -euo pipefail

rules=${VOS_NFT_RULES:-/usr/lib/vos/nftables.nft}
config=${VOS_CONFIG:-/var/lib/vos/config.json}
ports=${VOS_EXT_PORTS:-/var/lib/vos/ext/ports}

# True only for a literal JSON true. A missing file, a missing key or
# malformed JSON all read as false, so a broken config.json can close ports
# but never open them.
enabled() {
    [[ -r $config ]] && [[ $(jq -r "($1) == true" "$config" 2>/dev/null) == true ]]
}

# Optional ports are reachable from the local network only (the lan4/lan6
# sets in nftables.nft), unless web.allow_public opens them to everyone.
public=0
enabled .web.allow_public && public=1

optional=()
allow() { # allow PORT COMMENT
    if (( public )); then
        optional+=("tcp dport $1 accept comment \"$2\"")
    else
        optional+=("ip saddr @lan4 tcp dport $1 accept comment \"$2\""
                   "ip6 saddr @lan6 tcp dport $1 accept comment \"$2\"")
    fi
}
allow_lan() { # allow_lan PROTO PORT COMMENT: from the LAN sets only, always
    optional+=("ip saddr @lan4 $1 dport $2 accept comment \"$3\""
               "ip6 saddr @lan6 $1 dport $2 accept comment \"$3\"")
}

upstream=()

# Never an extension's port or upstream (descriptor.ReservedPort in vosd):
# Sunshine's admin UI and API, and Steam's debugger, which vosd would hand
# to the LAN as a proxied upstream.
reserved() { (( $1 == 47990 || $1 == 31911 )); }

# The extensions' ports, all or nothing: a damaged or hand-edited file
# never opens a port it did not mean to.
ext_ports() {
    [[ -f $ports && -r $ports ]] || return 0
    local line proto port up n=0 found=()
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^(tcp|udp)\ ([1-9][0-9]{3,4})$ || $line =~ ^(tcp)\ ([1-9][0-9]{3,4})\ upstream\ ([1-9][0-9]{3,4})$ ]] ||
            return 0
        port=${BASH_REMATCH[2]} up=${BASH_REMATCH[3]:-}
        (( port >= 1024 && port <= 65535 && ++n <= 64 )) && ! reserved "$port" || return 0
        [[ -z $up ]] || { (( up >= 1024 && up <= 65535 )) && ! reserved "$up"; } || return 0
        found+=("${BASH_REMATCH[1]} $port $up")
    done <"$ports"
    (( n )) || return 0
    for line in "${found[@]}"; do
        read -r proto port up <<<"$line"
        allow_lan "$proto" "$port" "extension $proto $port"
        [[ -z $up ]] ||
            upstream+=("tcp dport $up meta skuid != 0 reject with tcp reset comment \"extension upstream $up\"")
    done
}

(( public )) && allow 80 web.allow_public
enabled .web.https && allow 443 web.https
enabled .ssh.enabled && allow 22 ssh.enabled
ext_ports

ruleset() {
    cat "$rules"
    local rule
    for rule in "${optional[@]}"; do
        printf 'add rule inet vos optional %s\n' "$rule"
    done
    for rule in "${upstream[@]}"; do
        printf 'add rule inet vos upstream %s\n' "$rule"
    done
}

case ${1:-} in
    "")      ruleset | nft -f - ;;
    --check) ruleset | nft -c -f - ;;
    --print) ruleset ;;
    *)       echo "usage: vos-firewall [--check | --print]" >&2; exit 2 ;;
esac
