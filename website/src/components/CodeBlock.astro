---
// A terminal-style code block with a copy button. The button only appears
// when scripts run; the code stays selectable either way.
interface Props {
  code: string;
  title?: string;
  lang?: string;
}
const { code, title, lang = 'sh' } = Astro.props;
const text = code.replace(/^\n+|\s+$/g, '');
// One block per line, so long commands wrap with a hanging indent instead
// of running off the edge; comment lines are dimmed. Words up to 28
// characters never break (so "-keyform" stays whole); longer ones, like
// the key, may.
const lines = text.split('\n');
---
<figure class="code" data-lang={lang}>
  <figcaption class="code-bar">
    <span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="code-title">{title ?? 'Terminal'}</span>
    <button class="code-copy" type="button" data-copy={text} aria-label={`Copy ${title ?? 'code'}`}>
      <svg class="ico i-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      <svg class="ico i-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span class="code-copy-label">Copy</span>
    </button>
  </figcaption>
  <pre tabindex="0"><code>{lines.map((l) => (
    <span class:list={['ln', { cm: /^\s*#/.test(l) }]}>{l.split(/(\s+)/).map((t) => (t.length > 1 && t.length <= 28 && !/\s/.test(t) ? <span class="nw">{t}</span> : t))}</span>
  ))}</code></pre>
</figure>

<script>
  const status = document.createElement('p');
  status.className = 'sr-only';
  status.setAttribute('role', 'status');
  document.body.append(status);

  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.code-copy').forEach((btn) => {
    btn.hidden = false;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const ok = await copy(btn.dataset.copy ?? '');
      const label = btn.querySelector('.code-copy-label');
      btn.dataset.state = ok ? 'done' : 'failed';
      if (label) label.textContent = ok ? 'Copied' : 'Press Ctrl+C';
      status.textContent = ok ? 'Copied to the clipboard' : 'Copying failed; select the text and copy it';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete btn.dataset.state;
        if (label) label.textContent = 'Copy';
      }, 1800);
    });
  });
</script>

<style>
  .code {
    margin: 0;
    min-width: 0;
    border-radius: 14px;
    border: 1px solid var(--line-2);
    background: linear-gradient(180deg, #0d141c, #080d13);
    box-shadow: 0 1px 0 rgb(255 255 255 / .04) inset, 0 20px 40px -28px rgb(0 0 0 / .9);
    overflow: hidden;
  }
  .code-bar {
    display: flex; align-items: center; gap: 12px;
    padding: 8px 8px 8px 14px;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / .025);
  }
  .code-dots { display: inline-flex; gap: 6px; }
  .code-dots i { width: 9px; height: 9px; border-radius: 50%; background: rgb(150 185 220 / .22); }
  .code-title {
    margin-right: auto; min-width: 0;
    font: 500 .8rem/1.2 var(--mono); color: var(--text-3);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .code-copy {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 32px; padding: 0 10px;
    border-radius: 8px; border: 1px solid var(--line-2);
    background: rgb(255 255 255 / .04);
    color: var(--text-2); font: 600 .8rem/1 var(--font);
    cursor: pointer;
    transition: color .2s, background-color .2s, border-color .2s;
  }
  :global(html.no-js) .code-copy { display: none; }
  .code-copy:hover { color: var(--text); background: rgb(255 255 255 / .08); }
  .code-copy .ico { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .code-copy .i-done { display: none; }
  .code-copy[data-state="done"] { color: var(--ok); border-color: rgb(83 214 160 / .4); }
  .code-copy[data-state="done"] .i-done { display: block; }
  .code-copy[data-state="done"] .i-done { animation: pop .4s var(--ease-out); }
  @keyframes pop { from { transform: scale(.3) rotate(-20deg); opacity: 0; } }
  .code-copy[data-state="done"] .i-copy { display: none; }
  pre {
    margin: 0;
    padding: 16px 18px 18px;
    overflow-x: auto;
    font: 400 .86rem/1.75 var(--mono);
    color: #d5e6f7;
    tab-size: 2;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ln { display: block; padding-left: 2ch; text-indent: -2ch; }
  .ln:empty { height: .9em; }
  .cm { color: var(--text-3); }
  .nw { white-space: nowrap; }
  pre:focus-visible { outline-offset: -3px; }
  code { font: inherit; }
</style>
