---
// A static recreation of the VaporOS web UI dashboard (internal/web) and the
// welcome screen, drawn in HTML/CSS because the repo has no screenshots yet.
// Swap in real screenshots here when they exist.
interface Props {
  welcome?: 'os' | 'installer';
  phone?: boolean;
}
const { welcome = 'os', phone = true } = Astro.props;
const w = welcome === 'installer'
  ? { status: 'Ready to install', detail: 'Open this address on a phone or computer to install VaporOS', url: 'http://vaporos-setup.local', code: 'ABCD-EFGH' }
  : { status: 'Ready to stream', detail: 'Open this address on a phone or computer to pair Moonlight', url: 'http://vapor.local', code: '' };

// A decorative QR-like pattern (not a real code).
const cells: boolean[] = [];
let s = 7;
for (let i = 0; i < 21 * 21; i++) {
  s = (s * 1103515245 + 12345) & 0x7fffffff;
  const x = i % 21, y = Math.floor(i / 21);
  const finder = (x < 7 && y < 7) || (x > 13 && y < 7) || (x < 7 && y > 13);
  if (finder) {
    const fx = x > 13 ? x - 14 : x, fy = y > 13 ? y - 14 : y;
    cells.push(fx === 0 || fx === 6 || fy === 0 || fy === 6 || (fx > 1 && fx < 5 && fy > 1 && fy < 5));
  } else {
    cells.push(((s >> 16) & 3) === 0 || ((s >> 12) & 1) === 1);
  }
}
---
<div class:list={['mock', { 'tv-only': !phone }]} aria-hidden="true">
  <div class="tv">
    <div class="tv-screen">
      <div class="wl">
        <div class="wl-text">
          <p class="wl-brand">Vapor<b>OS</b></p>
          <p class="wl-status">{w.status}</p>
          <p class="wl-detail">{w.detail}</p>
          <p class="wl-url">{w.url}</p>
          <p class="wl-ip">http://192.168.1.50</p>
          {w.code && <p class="wl-code"><span>Setup code</span>{w.code}</p>}
        </div>
        <div class="wl-qr">
          <div class="qr">{cells.map((c) => <i class={c ? 'on' : ''}></i>)}</div>
          <span>Scan to open</span>
        </div>
      </div>
    </div>
    <div class="tv-stand"></div>
  </div>

  {phone && <div class="phone">
    <div class="phone-screen">
      <div class="notch"></div>
      <div class="ui-bar">
        <span class="ui-brand"><span class="ui-logo"></span><span>Vapor<b>OS</b></span></span>
        <span class="ui-live"><i></i>Live</span>
      </div>
      <div class="ui-body">
        <div class="ui-hero">
          <span class="ui-hero-icon">
            <svg viewBox="0 0 24 24"><path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><path d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59l-.9 7.33A3 3 0 0 0 4.77 19.3c.93 0 1.8-.46 2.34-1.22L8.5 16h7l1.39 2.08c.53.76 1.4 1.22 2.33 1.22a3 3 0 0 0 2.98-3.38l-.91-7.33A4 4 0 0 0 17.32 5Z"/></svg>
          </span>
          <span class="ui-eyebrow">vapor</span>
          <span class="ui-title">Ready to stream</span>
          <span class="ui-detail">Open Moonlight on any device and pick this PC.</span>
        </div>
        <div class="ui-card">
          <span class="ui-card-h">Updates</span>
          <span class="ui-row"><span class="ui-ok"></span>Up to date.</span>
        </div>
        <div class="ui-card">
          <span class="ui-card-h">This PC</span>
          <span class="ui-kv"><span>Address</span><span>vapor.local</span></span>
          <span class="ui-kv"><span>IP</span><span>192.168.1.50</span></span>
          <span class="ui-kv"><span>Graphics</span><span>AMD Radeon</span></span>
        </div>
        <div class="ui-card">
          <span class="ui-card-h">Quick actions</span>
          <div class="ui-quick">
            <span>Pair a device</span><span>Stay awake 1 h</span><span>Restart</span><span class="danger">Power off</span>
          </div>
        </div>
      </div>
    </div>
  </div>}
</div>

<style>
  .mock {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    aspect-ratio: 640 / 500;
    container-type: inline-size;
  }

  .tv-only { aspect-ratio: 16 / 9.6; }
  .tv-only .tv { width: 100%; }

  /* ---- TV with the welcome screen ---- */
  .tv { position: absolute; left: 0; top: 0; width: 86%; }
  .mock:not(.tv-only) .wl { padding-right: 22cqw; }
  .tv-screen {
    aspect-ratio: 16 / 9;
    padding: 1.6cqw;
    border-radius: 2.2cqw;
    background: #05080c;
    border: 1px solid rgb(150 185 220 / .18);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / .9), 0 0 0 1px rgb(0 0 0 / .6), 0 0 80px -30px rgb(76 150 232 / .5);
  }
  .tv-stand { width: 22%; height: 2.4cqw; margin: 0 auto; background: linear-gradient(180deg, #1a2430, #0c1219); border-radius: 0 0 1cqw 1cqw; }
  .wl {
    height: 100%;
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4cqw;
    padding: 0 5cqw;
    border-radius: 1.2cqw;
    background:
      radial-gradient(60% 70% at 20% 10%, rgb(120 190 255 / .14), transparent 70%),
      #0b1118;
    font-family: var(--font);
  }
  .wl-text { display: grid; gap: .5cqw; min-width: 0; }
  .wl p { margin: 0; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wl-brand { font-weight: 800; font-size: 4.4cqw; color: #e8eef5; letter-spacing: -.02em; }
  .wl-brand b { color: var(--brand); }
  .wl-status { font-weight: 700; font-size: 2.9cqw; color: #e8eef5; margin-top: 1.2cqw !important; }
  .wl-detail { font-size: 1.55cqw; color: #a9b7c6; white-space: normal !important; }
  .wl-url { font: 700 2.3cqw/1.2 var(--mono); color: var(--brand); margin-top: 1.4cqw !important; }
  .wl-ip { font: 500 1.6cqw/1.2 var(--mono); color: #a9b7c6; }
  .wl-code { font: 700 2.4cqw/1.2 var(--mono); color: #e8eef5; margin-top: 1cqw !important; display: grid; }
  .wl-code span { font: 400 1.4cqw/1.4 var(--font); color: #a9b7c6; }
  .wl-qr { display: grid; justify-items: center; gap: 1cqw; }
  .wl-qr span { font-size: 1.4cqw; color: #a9b7c6; }
  .qr {
    display: grid; grid-template-columns: repeat(21, 1fr);
    width: 20cqw; aspect-ratio: 1;
    padding: 1.2cqw; border-radius: 1cqw;
    background: #fff;
  }
  .qr i.on { background: #0b1118; }

  /* ---- phone with the dashboard ---- */
  .phone {
    position: absolute; right: 0; bottom: 0;
    width: 31%;
    aspect-ratio: 9 / 19;
    padding: 1.1cqw;
    border-radius: 6.4cqw;
    background: linear-gradient(145deg, #2a3643, #111820 40%, #1b2530);
    box-shadow: 0 50px 90px -30px rgb(0 0 0 / .95), 0 0 0 1px rgb(190 225 255 / .12) inset, 0 0 60px -20px rgb(120 190 255 / .4);
    animation: float 8s ease-in-out infinite;
    container-type: inline-size;
  }
  @keyframes float { 50% { transform: translateY(-1.6cqw); } }
  .phone-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 17.4cqw;
    background:
      radial-gradient(120% 40% at 10% -5%, rgb(120 190 255 / .16), transparent 60%),
      #0b1118;
    font-family: var(--font);
    color: #e8eef5;
  }
  .notch { position: absolute; left: 50%; top: 3.87cqw; width: 30%; height: 8.39cqw; transform: translateX(-50%); border-radius: 99px; background: #000; z-index: 2; }
  .ui-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 17.4cqw 8.4cqw 5.8cqw;
    border-bottom: 1px solid rgb(150 185 220 / .11);
    background: rgb(11 17 24 / .84);
  }
  .ui-brand { display: inline-flex; align-items: center; gap: 3.87cqw; font-weight: 700; font-size: 7.42cqw; letter-spacing: -.02em; }
  .ui-brand b { color: var(--brand); }
  .ui-logo { width: 11.61cqw; height: 11.61cqw; border-radius: 3.55cqw; background: linear-gradient(135deg, #8ccaff, #529ce9 55%, #2a5ea6); }
  .ui-live { display: inline-flex; align-items: center; gap: 2.58cqw; padding: 1.61cqw 4.19cqw; border-radius: 99px; font-size: 4.84cqw; color: var(--ok); background: #18232f; border: 1px solid rgb(150 185 220 / .11); }
  .ui-live i { width: 3.23cqw; height: 3.23cqw; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 1.61cqw var(--ok-soft); }
  .ui-body { display: grid; gap: 5.16cqw; padding: 7.1cqw; }
  .ui-hero, .ui-card {
    display: grid; gap: 1.6cqw;
    padding: 7.1cqw;
    border-radius: 7.7cqw;
    background: #121b25;
    border: 1px solid rgb(150 185 220 / .11);
  }
  .ui-hero { background: radial-gradient(90% 70% at 0% 0%, rgb(83 214 160 / .15), transparent 70%), #121b25; }
  .ui-hero-icon { display: grid; place-items: center; width: 20.65cqw; height: 20.65cqw; border-radius: 6.45cqw; background: var(--ok-soft); border: 1px solid rgb(83 214 160 / .4); color: var(--ok); margin-bottom: 2.58cqw; }
  .ui-hero-icon svg { width: 10.97cqw; height: 10.97cqw; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ui-eyebrow { font-size: 4.4cqw; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: #7a8b9e; }
  .ui-title { font-size: 9.03cqw; font-weight: 700; line-height: 1.15; }
  .ui-detail { font-size: 5cqw; color: #a9b7c6; line-height: 1.35; }
  .ui-card-h { font-size: 5.81cqw; font-weight: 650; margin-bottom: 1.29cqw; }
  .ui-row { display: flex; align-items: center; gap: 3.23cqw; font-size: 4.84cqw; color: #a9b7c6; }
  .ui-ok { width: 3.87cqw; height: 3.87cqw; border-radius: 50%; background: var(--ok); }
  .ui-kv { display: flex; justify-content: space-between; font-size: 4.68cqw; line-height: 1.6; }
  .ui-kv span:first-child { color: #a9b7c6; }
  .ui-kv span:last-child { font-weight: 550; }
  .ui-quick { display: grid; grid-template-columns: 1fr 1fr; gap: 3.23cqw; }
  .ui-quick span {
    padding: 4.5cqw 3.2cqw; border-radius: 4.5cqw;
    font-size: 4.3cqw; font-weight: 550; text-align: center;
    background: #18232f; border: 1px solid rgb(150 185 220 / .11);
  }
  .ui-quick .danger { color: var(--danger); }

  /* The screen ends in a fade, so the page reads as scrolling on. */
  .phone-screen::after {
    content: "";
    position: absolute; left: 0; right: 0; bottom: 0; height: 26%;
    background: linear-gradient(180deg, transparent, #0b1118 72%);
    pointer-events: none;
  }
  .phone-screen::before {
    content: "";
    position: absolute; left: 50%; bottom: 3.2cqw; z-index: 1;
    width: 34%; height: 1.6cqw; border-radius: 99px;
    transform: translateX(-50%);
    background: rgb(232 238 245 / .55);
  }

  /* Small screens: the phone alone, big enough to read. */
  @media (max-width: 639px) {
    .mock:not(.tv-only) { aspect-ratio: auto; max-width: 320px; padding-bottom: 12px; }
    .mock:not(.tv-only) .tv { display: none; }
    .mock:not(.tv-only) .phone { position: relative; width: 90%; margin-inline: auto; }
    .tv-only .wl { gap: 3cqw; padding: 0 4cqw; }
    .tv-only .wl-brand { font-size: 5cqw; }
    .tv-only .wl-status { font-size: 4cqw; }
    .tv-only .wl-detail, .tv-only .wl-ip { display: none; }
    .tv-only .wl-url { font-size: 3.3cqw; }
    .tv-only .wl-code { font-size: 3.6cqw; }
    .tv-only .wl-code span, .tv-only .wl-qr span { font-size: 2.6cqw; }
    .tv-only .qr { width: 24cqw; }
  }
  @media (prefers-reduced-motion: reduce) { .phone { animation: none; } }
</style>
