---
import Icon from './Icon.astro';
import { href } from '../lib/paths';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="mesh">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
      <span class="blob b4"></span>
    </div>
    <div class="floor"><div class="floor-grid"></div></div>
    <div class="grain"></div>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span class="badge badge-accent"><span class="dot"></span>Steam streaming appliance</span>
        <span class="kicker-text">for PCs with an AMD GPU</span>
      </p>
      <h1 id="hero-title">
        Your gaming PC,<br />
        <span class="gradient-text">as a streaming console.</span>
      </h1>
      <p class="lead hero-lead">
        VaporOS turns a PC into a headless Steam box. Play on your TV, phone or laptop with
        Moonlight, at each device's own resolution, frame rate and HDR. You set it up and run it
        from your phone. No terminal, ever.
      </p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary btn-lg" href={href('/download/')}>
          <Icon name="download" />Download VaporOS
        </a>
        <a class="btn btn-lg" href="#how">
          How it works<Icon name="arrow" />
        </a>
      </div>
      <ul class="hero-facts" aria-label="At a glance">
        <li><Icon name="layers" />Built on CachyOS</li>
        <li><Icon name="shield" />Signed A/B updates</li>
        <li><Icon name="moon" />Wakes from Moonlight</li>
      </ul>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="halo"></div>
      <div class="orbit o1"></div>
      <div class="orbit o2"></div>
      <svg class="steam" viewBox="0 0 400 520" focusable="false">
        <defs>
          <linearGradient id="hero-tile" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#9ad2ff" />
            <stop offset=".55" stop-color="#529ce9" />
            <stop offset="1" stop-color="#2a5ea6" />
          </linearGradient>
          <linearGradient id="hero-sheen" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".35" />
            <stop offset=".45" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="hero-wisp" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#e8f5ff" stop-opacity=".95" />
            <stop offset=".6" stop-color="#9fd4ff" stop-opacity=".5" />
            <stop offset="1" stop-color="#9fd4ff" stop-opacity="0" />
          </linearGradient>
          <radialGradient id="hero-shadow">
            <stop offset="0" stop-color="#4c96e8" stop-opacity=".55" />
            <stop offset="1" stop-color="#4c96e8" stop-opacity="0" />
          </radialGradient>
          <filter id="hero-soft" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3.2" />
          </filter>
        </defs>

        <ellipse cx="200" cy="486" rx="150" ry="22" fill="url(#hero-shadow)" />

        <!-- steam: the logo's three waves, rising and fading above the tile -->
        <g class="wisps" fill="none" stroke="url(#hero-wisp)" stroke-linecap="round" filter="url(#hero-soft)">
          <path class="wisp w1" d="M162 262c-16-13 16-27 0-40s16-27 0-40" stroke-width="12" />
          <path class="wisp w2" d="M200 250c-19-16 19-37 0-54s19-37 0-54" stroke-width="14" />
          <path class="wisp w3" d="M238 262c-16-13 16-27 0-40s16-27 0-40" stroke-width="12" />
        </g>

        <g class="tile">
          <rect x="95" y="265" width="210" height="210" rx="58" fill="url(#hero-tile)" />
          <rect x="95" y="265" width="210" height="210" rx="58" fill="url(#hero-sheen)" />
          <rect x="95.5" y="265.5" width="209" height="209" rx="57.5" fill="none" stroke="#cfe9ff" stroke-opacity=".45" />
          <svg x="95" y="265" width="210" height="210" viewBox="2 2 60 60">
            <g class="waves" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="5.5">
              <path class="wave v1" d="M20 47c-5-4 5-8.5 0-12.5s5-8.5 0-12.5" opacity=".8" />
              <path class="wave v2" d="M32 52c-6-5 6-11.5 0-17s6-11.5 0-17" />
              <path class="wave v3" d="M44 47c-5-4 5-8.5 0-12.5s5-8.5 0-12.5" opacity=".8" />
            </g>
          </svg>
        </g>
      </svg>

      <div class="float-chip c1 glass">
        <span class="live-dot"></span>
        <span><strong>Streaming to Living room TV</strong><small>3840x2160@60 HDR</small></span>
      </div>
      <div class="float-chip c2 glass">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg>
        <span><strong>vapor.local</strong><small>Ready to stream</small></span>
      </div>
    </div>
  </div>
  <div class="hero-fade" aria-hidden="true"></div>
  <div class="scroll-cue" aria-hidden="true"><span></span></div>
</section>

<script>
  // The art leans a little toward the pointer. Fine pointers only, and not
  // with reduced motion; one rAF per frame at most.
  const art = document.querySelector<HTMLElement>('.hero-art');
  const ok = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  if (art && ok.matches) {
    const hero = art.closest<HTMLElement>('.hero')!;
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        art.style.setProperty('--px', x.toFixed(3));
        art.style.setProperty('--py', y.toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      art.style.setProperty('--px', '0');
      art.style.setProperty('--py', '0');
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(100px + env(safe-area-inset-top)) 0 64px;
  }
  @media (min-width: 1024px) {
    .hero { min-height: min(88svh, 820px); display: grid; align-items: center; padding: 112px 0 88px; }
  }

  /* ---- background: drifting vapor mesh, a perspective floor and grain ---- */
  .hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .mesh { position: absolute; inset: -10%; }
  .blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    animation: drift 26s ease-in-out infinite alternate;
  }
  .b1 { width: 70vmax; height: 70vmax; left: -22vmax; top: -30vmax; background: radial-gradient(closest-side, rgb(120 190 255 / .34), transparent); }
  .b2 { width: 60vmax; height: 60vmax; right: -24vmax; top: -18vmax; background: radial-gradient(closest-side, rgb(155 135 255 / .26), transparent); animation-duration: 32s; animation-delay: -8s; }
  .b3 { width: 52vmax; height: 52vmax; left: 30%; top: 26%; background: radial-gradient(closest-side, rgb(76 150 232 / .22), transparent); animation-duration: 38s; animation-delay: -14s; }
  .b4 { width: 36vmax; height: 36vmax; left: 4%; bottom: -12vmax; background: radial-gradient(closest-side, rgb(111 227 255 / .14), transparent); animation-duration: 29s; animation-delay: -4s; }
  @keyframes drift {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(4vmax, 3vmax, 0) scale(1.08); }
    100% { transform: translate3d(-3vmax, 5vmax, 0) scale(.96); }
  }
  .floor {
    position: absolute; left: -50%; right: -50%; bottom: -8%; height: 58%;
    perspective: 520px;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 45%, #000 70%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 45%, #000 70%, transparent 100%);
    opacity: .5;
  }
  .floor-grid {
    position: absolute; inset: 0;
    transform: rotateX(64deg);
    transform-origin: 50% 100%;
    background-image:
      linear-gradient(rgb(120 190 255 / .22) 1px, transparent 1px),
      linear-gradient(90deg, rgb(120 190 255 / .22) 1px, transparent 1px);
    background-size: 64px 64px;
    animation: floor 6s linear infinite;
  }
  @keyframes floor { to { background-position: 0 64px, 0 0; } }
  .grain {
    position: absolute; inset: 0;
    opacity: .07;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .hero-fade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 160px; z-index: -1;
    background: linear-gradient(180deg, transparent, var(--bg-deep));
    pointer-events: none;
  }

  /* ---- layout ---- */
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr); gap: 32px; }
  }

  /* ---- copy ---- */
  .hero-copy { display: grid; justify-items: start; gap: 22px; }
  .hero-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; }
  .kicker-text { color: var(--text-3); font-size: .9rem; }
  h1 {
    font-size: clamp(2.6rem, 1.2rem + 6.6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -.045em;
    font-weight: 700;
  }
  h1 .gradient-text {
    padding-bottom: .06em;
    background-size: 220% 100%;
    animation: sheen 14s ease-in-out infinite alternate;
  }
  @keyframes sheen { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }
  .hero-lead { max-width: 56ch; }
  .hero-ctas { margin-top: 4px; }
  .hero-facts {
    display: flex; flex-wrap: wrap; gap: 10px 22px;
    list-style: none;
    color: var(--text-2); font-size: .92rem;
  }
  .hero-facts li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-facts :global(.ico) { color: var(--brand); width: 18px; height: 18px; }

  /* entrance */
  .hero-copy > * { animation: rise 1s var(--ease-out) both; }
  /* The headline is the page's main message (and its LCP): it is readable
     from the first frame and only settles into place. */
  .hero-copy > h1 { animation: settle .9s var(--ease-out) both; }
  @keyframes settle { from { transform: translateY(10px); } }
  .hero-copy > :nth-child(2) { animation-delay: .08s; }
  .hero-copy > :nth-child(3) { animation-delay: .16s; }
  .hero-copy > :nth-child(4) { animation-delay: .24s; }
  .hero-copy > :nth-child(5) { animation-delay: .32s; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }

  /* ---- art ---- */
  .hero-art {
    position: relative;
    width: min(100%, 440px);
    margin-inline: auto;
    aspect-ratio: 400 / 520;
    animation: rise 1.2s .2s var(--ease-out) both;
    --px: 0; --py: 0;
  }
  .steam, .halo, .orbit { transition: translate .9s var(--ease-out); }
  .steam { translate: calc(var(--px) * 14px) calc(var(--py) * 10px); }
  .halo { translate: calc(var(--px) * -22px) calc(var(--py) * -16px); }
  .float-chip { translate: calc(var(--px) * 26px) calc(var(--py) * 18px); transition: translate 1.1s var(--ease-out); }
  .c2 { translate: calc(var(--px) * -20px) calc(var(--py) * -14px); }
  @media (max-width: 1023px) {
    .hero-art { width: min(74%, 340px); }
  }
  .steam { position: relative; width: 100%; height: 100%; overflow: visible; }
  .halo {
    position: absolute; left: 50%; top: 66%;
    width: 150%; aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgb(120 190 255 / .3), rgb(91 124 255 / .1) 45%, transparent 70%);
    animation: pulse 7s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: .7; transform: translate(-50%, -50%) scale(1.06); } }
  .orbit {
    position: absolute; left: 50%; top: 70%;
    border-radius: 50%;
    border: 1px solid rgb(150 200 255 / .16);
    transform: translate(-50%, -50%) rotateX(72deg);
  }
  .o1 { width: 118%; aspect-ratio: 1; }
  .o2 { width: 88%; aspect-ratio: 1; border-color: rgb(150 200 255 / .1); border-style: dashed; animation: spin 60s linear infinite; }
  @keyframes spin { to { transform: translate(-50%, -50%) rotateX(72deg) rotate(360deg); } }

  .tile { animation: bob 6s ease-in-out infinite; transform-origin: 200px 370px; }
  @keyframes bob { 50% { transform: translateY(-8px); } }
  .wave { animation: shimmer 4.8s ease-in-out infinite; }
  .v1 { animation-delay: 1.6s; }
  .v3 { animation-delay: 3.2s; }
  @keyframes shimmer { 0%, 100% { opacity: .78; } 25% { opacity: 1; } }

  .wisp {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    opacity: 0;
    animation: steam 4.8s cubic-bezier(.3, .1, .3, 1) infinite;
  }
  .w1 { animation-delay: 1.6s; }
  .w2 { animation-delay: 0s; }
  .w3 { animation-delay: 3.2s; }
  @keyframes steam {
    0% { opacity: 0; transform: translateY(26px) scale(.8, .7); }
    25% { opacity: .9; }
    70% { opacity: .35; }
    100% { opacity: 0; transform: translateY(-118px) scale(1.25, 1.1); }
  }

  .float-chip {
    position: absolute;
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px 12px 14px;
    border-radius: 16px;
    background: var(--glass), rgb(14 22 31 / .68);
    font-size: .85rem;
    white-space: nowrap;
    animation: hover 7s ease-in-out infinite;
  }
  .float-chip span { display: grid; gap: 1px; }
  .float-chip strong { font-weight: 650; color: var(--text); }
  .float-chip small { color: var(--text-2); font-family: var(--mono); font-size: .76rem; }
  .float-chip .ico { width: 20px; height: 20px; color: var(--brand); }
  .c1 { left: -16%; top: 38%; }
  .c2 { right: -8%; top: 86%; animation-delay: -3.5s; }
  .live-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px var(--ok-soft), 0 0 16px var(--ok); }
  @keyframes hover { 50% { transform: translateY(-10px); } }
  @media (max-width: 559px) {
    .float-chip { font-size: .78rem; padding: 10px 12px; }
    .c1 { left: -8%; top: 10%; }
    .c2 { right: -8%; top: 86%; }
  }
  @media (max-width: 400px) {
    .c1 { left: -12%; top: 6%; }
    .c2 { right: -12%; }
  }

  /* A quiet cue that the page goes on, on screens tall enough to need it. */
  .scroll-cue { display: none; }
  @media (min-width: 1024px) and (min-height: 760px) {
    .scroll-cue {
      display: block;
      position: absolute; left: 50%; bottom: 26px;
      width: 24px; height: 38px; margin-left: -12px;
      border-radius: 99px;
      border: 1.5px solid rgb(150 185 220 / .3);
      animation: rise 1s 1.1s var(--ease-out) both;
    }
    .scroll-cue span {
      position: absolute; left: 50%; top: 8px;
      width: 3px; height: 8px; margin-left: -1.5px; border-radius: 3px;
      background: var(--brand);
      animation: cue 2.2s var(--ease) infinite;
    }
    @keyframes cue {
      0% { opacity: 0; transform: translateY(-2px); }
      30% { opacity: 1; }
      80%, 100% { opacity: 0; transform: translateY(12px); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wisp { opacity: .55; animation: none; transform: translateY(-40px); }
    .w1, .w3 { opacity: .35; }
    .wave, .orbit, .blob, .floor-grid, .halo, .tile, .float-chip, .scroll-cue span, h1 .gradient-text { animation: none; }
  }
</style>
