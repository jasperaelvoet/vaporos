---
// The VaporOS mark (internal/web/static/icon.svg) and the Vapor**OS**
// wordmark, with "OS" in the accent colour as the product draws it.
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { size = 32, wordmark = true, class: cls = '' } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---
<span class:list={['logo', cls]}>
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8ccaff" />
        <stop offset=".55" stop-color="#529ce9" />
        <stop offset="1" stop-color="#2a5ea6" />
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="60" height="60" rx="17" fill={`url(#${id})`} />
    <g fill="none" stroke="#fff" stroke-linecap="round" stroke-width="5.5">
      <path d="M20 47c-5-4 5-8.5 0-12.5s5-8.5 0-12.5" opacity=".78" />
      <path d="M32 52c-6-5 6-11.5 0-17s6-11.5 0-17" />
      <path d="M44 47c-5-4 5-8.5 0-12.5s5-8.5 0-12.5" opacity=".78" />
    </g>
  </svg>
  {wordmark && <span class="wordmark">Vapor<b>OS</b></span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo-mark { flex: none; filter: drop-shadow(0 6px 16px rgb(120 190 255 / .45)); }
  .wordmark {
    font-family: var(--display);
    font-size: 1.2rem; font-weight: 700; letter-spacing: -.03em;
    color: var(--text);
  }
  .wordmark b { color: var(--brand); font-weight: 700; }
</style>
