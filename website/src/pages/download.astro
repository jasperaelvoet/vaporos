---
import Base from '../layouts/Base.astro';
import DownloadCard from '../components/DownloadCard.astro';
import Requirements from '../components/Requirements.astro';
import VerifySteps from '../components/VerifySteps.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { RELEASES_URL } from '../lib/release-shape';
---
<Base title="Download" current="download" description="Download the latest VaporOS ISO, check the requirements, and verify the download with SHA256SUMS and the release signature.">
  <section class="page-hero">
    <div class="container container-narrow">
      <span class="eyebrow">Download</span>
      <h1>Get <span class="gradient-text">VaporOS</span></h1>
      <p class="lead">One ISO. Write it to a USB stick, boot the PC from it, and finish the setup on your phone.</p>
    </div>
  </section>

  <section class="section-tight card-section">
    <div class="container container-narrow">
      <DownloadCard />
      <div class="notes">
        <div class="callout">
          <Icon name="info" />
          <p>
            <strong>Channels.</strong> Releases from <code>main</code> are the stable channel shown above.
            Builds from other branches are published as <a href={RELEASES_URL}>prereleases</a> for testing.
            An installed PC follows its channel by itself, so you only download an ISO once.
          </p>
        </div>
        <p class="next"><a class="link-arrow" href={href('/install/')}>Next: the install guide<Icon name="arrow" /></a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="req-title">
    <div class="container container-narrow">
      <div class="section-head">
        <span class="eyebrow">Requirements</span>
        <h2 id="req-title" class="h2">What you need</h2>
      </div>
      <Requirements />
    </div>
  </section>

  <section class="section verify-section" id="verify" aria-labelledby="verify-title">
    <div class="container container-narrow">
      <div class="section-head">
        <span class="eyebrow">Verify</span>
        <h2 id="verify-title" class="h2">Check your download</h2>
        <p class="lead">
          Optional, and quick. Download <code>SHA256SUMS</code>, <code>manifest.json</code> and{' '}
          <code>manifest.json.sig</code>{' '}from the same release as the ISO, then run these in that folder.
        </p>
      </div>
      <VerifySteps />
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-bottom: 32px; }
  .notes { display: grid; gap: 20px; margin-top: 24px; }
  .next { justify-self: start; }
  .verify-section { background: linear-gradient(180deg, transparent, rgb(11 17 24 / .8) 30%, var(--bg-deep)); }
</style>
