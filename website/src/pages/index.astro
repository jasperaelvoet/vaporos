---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import InstallSteps from '../components/InstallSteps.astro';
import DeviceMock from '../components/DeviceMock.astro';
import DownloadCard from '../components/DownloadCard.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { faq } from '../lib/faq';
import { href } from '../lib/paths';

const topFaq = faq.filter((f) => ['gpu', 'monitor', 'dual-boot', 'rollback'].includes(f.id));
---
<Base current="home">
  <Hero />
  <FeatureGrid />
  <HowItWorks />

  <section class="section setup" aria-labelledby="setup-title">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Setup</span>
        <h2 id="setup-title" class="h2">Three steps.<br /><span class="gradient-text">Then it's all phone.</span></h2>
        <p class="lead">Once the PC boots from the USB stick, the rest happens in your phone's browser. The PC itself only shows where to go.</p>
      </div>
      <InstallSteps />
    </div>
  </section>

  <section class="section control" aria-labelledby="control-title">
    <div class="container control-grid">
      <div class="control-copy reveal">
        <span class="eyebrow">Control center</span>
        <h2 id="control-title" class="h2">Your console,<br /><span class="gradient-text">in your pocket.</span></h2>
        <p class="lead">
          Open <code>vapor.local</code> on your phone and everything is there. The screen on the PC,
          if you have one, just tells you where to go.
        </p>
        <ul class="control-list">
          <li><Icon name="phone" /><span><strong>Pair</strong> Moonlight devices with a 4-digit PIN.</span></li>
          <li><Icon name="hdr" /><span><strong>Display</strong> modes and HDR, learned from each device.</span></li>
          <li><Icon name="drive" /><span><strong>Storage</strong> for game drives you already have.</span></li>
          <li><Icon name="update" /><span><strong>Updates</strong> and one-tap rollback.</span></li>
          <li><Icon name="power" /><span><strong>Power</strong>: idle shutdown, stay awake and Wake-on-LAN.</span></li>
        </ul>
      </div>
      <div class="control-art reveal" style="--i:1">
        <DeviceMock />
        <p class="mock-note">Illustration of the VaporOS web UI and the welcome screen on a connected monitor.</p>
      </div>
    </div>
  </section>

  <section class="section get" id="get" aria-labelledby="get-title">
    <div class="container container-narrow">
      <div class="section-head center reveal">
        <span class="eyebrow">Download</span>
        <h2 id="get-title" class="h2">Turn it into a <span class="gradient-text">console tonight.</span></h2>
      </div>
      <div class="reveal"><DownloadCard compact headingLevel="h3" /></div>
    </div>
  </section>

  <section class="section section-tight faq-teaser" aria-labelledby="faq-title">
    <div class="container container-narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Questions</span>
        <h2 id="faq-title" class="h2">Good to know</h2>
      </div>
      <div class="reveal"><FAQ items={topFaq} /></div>
      <p class="faq-more reveal"><a class="link-arrow" href={href('/faq/')}>All questions<Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<style>
  .setup { background: var(--bg-deep); }
  /* The glow is part of the section's own background, so no element edge
     can clip it into a visible box. */
  .control {
    background:
      radial-gradient(46% 58% at 74% 48%, rgb(91 124 255 / .13), transparent 72%),
      radial-gradient(30% 40% at 12% 30%, rgb(120 190 255 / .05), transparent 70%),
      var(--bg-deep);
  }
  .control-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1024px) { .control-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 56px; } }
  .control-copy { display: grid; gap: 18px; justify-items: start; }
  .control-list { list-style: none; display: grid; gap: 12px; margin-top: 8px; }
  .control-list li { display: flex; gap: 14px; align-items: flex-start; color: var(--text-2); }
  .control-list :global(.ico) { width: 20px; height: 20px; margin-top: 3px; color: var(--brand); }
  .control-list strong { color: var(--text); }
  .mock-note { margin-top: 16px; text-align: center; color: var(--text-3); font-size: .82rem; }

  .get {
    background:
      radial-gradient(60% 50% at 50% 40%, rgb(120 190 255 / .1), transparent 70%),
      var(--bg-deep);
  }
  .faq-more { margin-top: 24px; }
</style>
