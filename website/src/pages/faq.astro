---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { faq } from '../lib/faq';
import { REPO_URL } from '../lib/release-shape';
---
<Base title="FAQ" current="faq" description="Answers about VaporOS: supported graphics cards, monitors, dual boot, Secure Boot, updates, rollback and power.">
  <section class="page-hero">
    <div class="container container-narrow">
      <span class="eyebrow">FAQ</span>
      <h1>Questions, <span class="gradient-text">answered.</span></h1>
      <p class="lead">What VaporOS runs on, what it does to your PC, and how it keeps itself up to date.</p>
    </div>
  </section>
  <section class="section-tight faq-section">
    <div class="container container-narrow">
      <FAQ items={faq} />
      <div class="callout ask">
        <Icon name="question" />
        <p>Something else? <a href={`${REPO_URL}/issues`}>Open an issue on GitHub</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-bottom: 32px; }
  .faq-section { padding-bottom: clamp(72px, 10vw, 128px); }
  .ask { margin-top: 32px; }
</style>
