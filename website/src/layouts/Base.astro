---
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { href, SITE_NAME } from '../lib/paths';
import { REPO_URL, RELEASES_URL } from '../lib/release-shape';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'download' | 'install' | 'faq';
  // For the 404 page: GitHub Pages serves it at any missing path, so it gets
  // no canonical URL and asks not to be indexed.
  noindex?: boolean;
}

const {
  title,
  description = 'VaporOS turns a PC with an AMD GPU into a headless Steam streaming box. Play on your TV, phone or laptop with Moonlight. Set up and manage it from your phone.',
  current,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: your gaming PC, as a streaming console`;
const site = Astro.site ?? new URL('https://jasperaelvoet.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(href('/og.png'), site).href;

const nav = [
  { key: 'download', label: 'Download', path: '/download/' },
  { key: 'install', label: 'Install guide', path: '/install/' },
  { key: 'faq', label: 'FAQ', path: '/faq/' },
] as const;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#060a0f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VaporOS: your gaming PC, as a streaming console." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="home-link" href={href('/')} aria-label="VaporOS home" aria-current={current === 'home' ? 'page' : undefined}>
          <Logo size={30} />
        </a>
        <nav class="nav-desktop" aria-label="Main">
          <ul>
            {nav.filter((n) => n.key !== 'download').map((n) => (
              <li><a href={href(n.path)} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a href={REPO_URL} class="nav-gh"><Icon name="github" />GitHub</a></li>
          </ul>
        </nav>
        <a class="btn btn-primary btn-sm header-cta" href={href('/download/')} aria-current={current === 'download' ? 'page' : undefined}>
          <Icon name="download" />Download
        </a>
        <details class="nav-mobile">
          <summary aria-label="Menu">
            <Icon name="menu" class="ico when-closed" />
            <Icon name="close" class="ico when-open" />
          </summary>
          <nav class="nav-sheet" aria-label="Main menu">
            <ul>
              <li><a href={href('/')} aria-current={current === 'home' ? 'page' : undefined}>Home</a></li>
              {nav.map((n) => (
                <li><a href={href(n.path)} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
              ))}
              <li><a href={REPO_URL}><Icon name="github" />GitHub</a></li>
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <div class="nav-scrim" hidden></div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <Logo size={34} />
            <p class="muted">An immutable, CachyOS-based appliance that turns a PC with an AMD GPU into a headless Steam streaming box.</p>
          </div>
          <nav aria-label="Product">
            <h2 class="footer-h">Product</h2>
            <ul>
              <li><a href={href('/download/')}>Download</a></li>
              <li><a href={href('/install/')}>Install guide</a></li>
              <li><a href={href('/faq/')}>FAQ</a></li>
              <li><a href={href('/download/#verify')}>Verify a download</a></li>
            </ul>
          </nav>
          <nav aria-label="Project">
            <h2 class="footer-h">Project</h2>
            <ul>
              <li><a href={REPO_URL}>Source on GitHub</a></li>
              <li><a href={RELEASES_URL}>Releases</a></li>
              <li><a href={`${REPO_URL}/issues`}>Report an issue</a></li>
              <li><a href={`${REPO_URL}#development`}>Build from source</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-base">
          <p>License: TBD</p>
          <p>Not affiliated with Valve, Moonlight or Sunshine. Steam is a trademark of Valve Corporation.</p>
        </div>
      </div>
    </footer>

    <script>
      // Scroll reveals: elements marked .reveal fade in once, as they enter.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // Close the mobile menu after picking a link, tapping outside it, or
      // pressing Escape.
      const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) menu.open = false;
      });
      const scrim = document.querySelector<HTMLElement>('.nav-scrim');
      menu?.addEventListener('toggle', () => {
        if (scrim) scrim.hidden = !menu.open;
      });
      document.addEventListener('pointerdown', (e) => {
        if (menu?.open && !(e.target as HTMLElement).closest('.nav-mobile summary, .nav-sheet')) menu.open = false;
      });

      // Cards marked .spot catch a soft light under the pointer.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let raf = 0;
        document.addEventListener('pointermove', (e) => {
          const el = (e.target as HTMLElement).closest<HTMLElement>('.spot');
          if (!el) return;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        }, { passive: true });
        document.addEventListener('pointerout', (e) => {
          const el = (e.target as HTMLElement).closest<HTMLElement>('.spot');
          if (el && !el.contains(e.relatedTarget as Node)) {
            el.style.removeProperty('--mx');
            el.style.removeProperty('--my');
          }
        });
      }

      // The header gains depth once the page scrolls under it.
      const header = document.querySelector<HTMLElement>('.site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>

    <style>
      .site-header {
        position: fixed; inset: 0 0 auto; z-index: 50;
        padding-top: env(safe-area-inset-top);
        background: linear-gradient(180deg, rgb(6 10 15 / .82), rgb(6 10 15 / .55));
        -webkit-backdrop-filter: blur(18px) saturate(160%);
        backdrop-filter: blur(18px) saturate(160%);
        border-bottom: 1px solid transparent;
        transition: border-color .3s, box-shadow .3s, background-color .3s;
      }
      .site-header.is-scrolled {
        border-bottom-color: var(--line);
        box-shadow: 0 12px 40px -24px rgb(0 0 0 / .9);
      }
      .header-inner { display: flex; align-items: center; gap: 12px; height: 64px; }
      .home-link { display: inline-flex; margin-right: auto; text-decoration: none; border-radius: 10px; }
      .nav-desktop { display: none; }
      .nav-desktop ul { display: flex; align-items: center; gap: 4px; list-style: none; }
      .nav-desktop a {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 14px; border-radius: 10px;
        color: var(--text-2); font-weight: 550; font-size: .95rem; text-decoration: none;
        transition: color .2s, background-color .2s;
      }
      .nav-desktop a:hover { color: var(--text); background: rgb(255 255 255 / .05); }
      .nav-desktop a[aria-current="page"] { color: var(--text); background: rgb(120 190 255 / .1); }
      .nav-desktop .ico { width: 18px; height: 18px; }
      .header-cta { min-height: 40px; }
      .header-cta[aria-current="page"] { box-shadow: 0 0 0 2px var(--bg-deep), 0 0 0 4px rgb(120 190 255 / .55), var(--shadow-glow); }

      .nav-mobile { position: static; }
      .nav-mobile summary {
        display: grid; place-items: center;
        width: 42px; height: 42px;
        border-radius: 12px;
        border: 1px solid var(--line-2);
        background: rgb(255 255 255 / .04);
        color: var(--text);
        cursor: pointer; list-style: none;
      }
      .nav-mobile summary::-webkit-details-marker { display: none; }
      .nav-mobile summary .ico { width: 22px; height: 22px; }
      .nav-mobile :global(.when-open), .nav-mobile[open] :global(.when-closed) { display: none; }
      .nav-mobile[open] :global(.when-open) { display: block; }
      /* A nested backdrop-filter can't blur the page (the header already
         does), so the sheet is opaque, over a scrim that dims the page. */
      .nav-scrim {
        position: fixed; inset: 0; z-index: 49;
        background: rgb(3 6 10 / .62);
        animation: fade .25s var(--ease-out);
      }
      @media (min-width: 860px) { .nav-scrim { display: none; } }
      .nav-sheet {
        position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% + 8px);
        padding: 10px;
        background: linear-gradient(180deg, #172230, #101923);
        border: 1px solid var(--line-2);
        border-radius: var(--radius);
        box-shadow: 0 30px 80px -20px rgb(0 0 0 / .9), 0 1px 0 rgb(255 255 255 / .06) inset;
        transform-origin: 90% 0;
        animation: sheet .3s var(--ease-out);
      }
      .nav-sheet ul { list-style: none; display: grid; gap: 2px; }
      .nav-sheet a {
        display: flex; align-items: center; gap: 10px;
        padding: 13px 14px; border-radius: 12px;
        color: var(--text); font-weight: 600; text-decoration: none;
      }
      .nav-sheet a:hover { background: rgb(255 255 255 / .05); }
      .nav-sheet a[aria-current="page"] { background: var(--accent-soft); color: var(--brand); }
      @keyframes sheet { from { opacity: 0; transform: translateY(-8px) scale(.98); } }
      @keyframes fade { from { opacity: 0; } }

      @media (max-width: 379px) {
        .header-cta { padding: 0 12px; }
        .header-cta :global(.ico) { display: none; }
      }
      @media (min-width: 860px) {
        .nav-desktop { display: block; }
        .nav-mobile { display: none; }
        .header-inner { height: 72px; }
      }

      main { display: block; outline: none; }

      .site-footer {
        position: relative;
        margin-top: 0;
        padding: 64px 0 calc(40px + env(safe-area-inset-bottom));
        border-top: 1px solid var(--line);
        background:
          radial-gradient(700px 240px at 50% 0%, rgb(120 190 255 / .07), transparent 70%),
          var(--bg-deep);
      }
      .footer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 24px; }
      .footer-brand { grid-column: 1 / -1; }
      .footer-brand { display: grid; gap: 16px; max-width: 360px; }
      .footer-brand p { font-size: .95rem; }
      .footer-h { font: 600 .78rem/1 var(--font); letter-spacing: .14em; text-transform: uppercase; color: var(--text-3); margin-bottom: 14px; }
      .site-footer ul { list-style: none; display: grid; gap: 10px; }
      .site-footer nav a { color: var(--text-2); text-decoration: none; }
      .site-footer nav a:hover { color: var(--text); text-decoration: underline; }
      .footer-base {
        display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
        margin-top: 48px; padding-top: 24px;
        border-top: 1px solid var(--line);
        color: var(--text-3); font-size: .875rem;
      }
      @media (min-width: 720px) {
        .footer-grid { grid-template-columns: 2fr 1fr 1fr; }
        .footer-brand { grid-column: auto; }
      }
    </style>
  </body>
</html>
