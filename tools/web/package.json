{
  "name": "vaporos-web-tools",
  "private": true,
  "type": "module",
  "description": "Dev and CI tooling for the control center in internal/web: the Tailwind build of static/app.css and the headless browser harness. Nothing here ships in the OS image.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "css": "node css.mjs build",
    "css:check": "node css.mjs --check",
    "css:watch": "node css.mjs --watch",
    "dev": "node dev.mjs",
    "e2e": "node e2e/run.mjs",
    "perf": "node e2e/perf.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "axe-core": "4.13.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3"
  }
}
