From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jasper Aelvoet <jasper.aelvoet@me.com>
Date: Mon, 23 Nov 2026 23:25:13 +0100
Subject: [PATCH] Add the PyroWave codec, encoded from the KMS capture through
 Vulkan with the cursor drawn in


diff --git a/cmake/compile_definitions/linux.cmake b/cmake/compile_definitions/linux.cmake
index 1188d402..98002efc 100644
--- a/cmake/compile_definitions/linux.cmake
+++ b/cmake/compile_definitions/linux.cmake
@@ -220,6 +220,45 @@ if(${SUNSHINE_ENABLE_VULKAN})
     set(SUNSHINE_TARGET_DEPENDENCIES ${SUNSHINE_TARGET_DEPENDENCIES} vulkan_shaders)
 endif()
 
+# pyrowave (intra-only wavelet codec, encoded on the KMS capture through Vulkan)
+if(${SUNSHINE_ENABLE_PYROWAVE})
+    if(NOT ${SUNSHINE_ENABLE_VULKAN} OR NOT ${SUNSHINE_ENABLE_DRM})
+        message(FATAL_ERROR "SUNSHINE_ENABLE_PYROWAVE needs SUNSHINE_ENABLE_VULKAN and SUNSHINE_ENABLE_DRM")
+    endif()
+    pkg_check_modules(PYROWAVE REQUIRED IMPORTED_TARGET pyrowave-shared)
+    list(APPEND SUNSHINE_DEFINITIONS SUNSHINE_BUILD_PYROWAVE=1)
+    list(APPEND PLATFORM_LIBRARIES PkgConfig::PYROWAVE)
+    list(APPEND PLATFORM_TARGET_FILES
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/pyrowave_encode.h"
+            "${CMAKE_SOURCE_DIR}/src/platform/linux/pyrowave_encode.cpp")
+
+    # The pass that copies the capture and draws the cursor before encoding
+    set(PYROWAVE_SHADER_SOURCE "${SUNSHINE_SOURCE_ASSETS_DIR}/linux/assets/shaders/vulkan/pyrowave_compose.comp")
+    set(PYROWAVE_SHADER_SPV "${VULKAN_SHADER_DIR}/pyrowave_compose.spv")
+    set(PYROWAVE_SHADER_DATA "${VULKAN_SHADER_DIR}/pyrowave_compose.spv.inc")
+    if(GLSLC_EXECUTABLE)
+        add_custom_command(
+                OUTPUT "${PYROWAVE_SHADER_SPV}"
+                COMMAND ${GLSLC_EXECUTABLE} -O "${PYROWAVE_SHADER_SOURCE}" -o "${PYROWAVE_SHADER_SPV}"
+                DEPENDS "${PYROWAVE_SHADER_SOURCE}"
+                VERBATIM)
+    else()
+        add_custom_command(
+                OUTPUT "${PYROWAVE_SHADER_SPV}"
+                COMMAND ${GLSLANG_EXECUTABLE} -V -o "${PYROWAVE_SHADER_SPV}" "${PYROWAVE_SHADER_SOURCE}"
+                DEPENDS "${PYROWAVE_SHADER_SOURCE}"
+                VERBATIM)
+    endif()
+    add_custom_command(
+            OUTPUT "${PYROWAVE_SHADER_DATA}"
+            COMMAND ${CMAKE_COMMAND} -DSPV_FILE=${PYROWAVE_SHADER_SPV} -DOUT_FILE=${PYROWAVE_SHADER_DATA}
+                -P "${CMAKE_SOURCE_DIR}/cmake/scripts/binary_to_c.cmake"
+            DEPENDS "${PYROWAVE_SHADER_SPV}"
+            VERBATIM)
+    add_custom_target(pyrowave_shaders DEPENDS "${PYROWAVE_SHADER_DATA}")
+    set(SUNSHINE_TARGET_DEPENDENCIES ${SUNSHINE_TARGET_DEPENDENCIES} pyrowave_shaders)
+endif()
+
 # wayland
 if(${SUNSHINE_ENABLE_WAYLAND})
     find_package(Wayland REQUIRED)
