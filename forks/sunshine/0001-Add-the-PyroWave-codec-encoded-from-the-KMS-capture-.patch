diff --git a/src_assets/linux/assets/shaders/vulkan/pyrowave_compose.comp b/src_assets/linux/assets/shaders/vulkan/pyrowave_compose.comp
new file mode 100644
index 00000000..3a1215fc
--- /dev/null
+++ b/src_assets/linux/assets/shaders/vulkan/pyrowave_compose.comp
@@ -0,0 +1,34 @@
+#version 450
+
+// Copies the visible part of the KMS capture into the PyroWave encoder's
+// input and draws the cursor, which KMS keeps on a plane of its own.
+
+layout(local_size_x = 16, local_size_y = 16) in;
+
+layout(set = 0, binding = 0) uniform sampler2D rgb_in;
+layout(set = 0, binding = 1) uniform sampler2D cursor_in;
+layout(set = 0, binding = 2, rgba8) uniform writeonly image2D rgb_out;
+
+layout(push_constant) uniform PushConstants {
+  ivec2 src_offset;
+  ivec2 size;
+  ivec2 cursor_pos;
+  ivec2 cursor_size;  // w=0 means no cursor
+} pc;
+
+void main() {
+  ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
+  if (pos.x >= pc.size.x || pos.y >= pc.size.y)
+    return;
+
+  vec3 rgb = texelFetch(rgb_in, pos + pc.src_offset, 0).rgb;
+
+  ivec2 cp = pos - pc.cursor_pos;
+  if (pc.cursor_size.x > 0 && cp.x >= 0 && cp.y >= 0 && cp.x < pc.cursor_size.x && cp.y < pc.cursor_size.y) {
+    // Same cursor sampling and channel order as rgb2yuv.comp
+    vec4 c = texture(cursor_in, (vec2(cp) + 0.5) / vec2(pc.cursor_size));
+    rgb = mix(rgb, c.bgr, c.a);
+  }
+
+  imageStore(rgb_out, pos, vec4(rgb, 1.0));
+}
