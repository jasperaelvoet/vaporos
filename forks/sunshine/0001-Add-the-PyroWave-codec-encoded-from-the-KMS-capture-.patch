+/**
+ * @file src/platform/linux/pyrowave_encode.h
+ * @brief PyroWave encoder: KMS DMA-BUF -> PyroWave (Vulkan compute) -> one frame of packets.
+ */
+#pragma once
+
+#include <memory>
+
+#include "src/platform/common.h"
+
+namespace pw {
+  /**
+   * @brief Create a PyroWave encode device for a KMS capture.
+   *
