From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jasper Aelvoet <jasper.aelvoet@me.com>
Date: Tue, 24 Nov 2026 00:57:55 +0100
Subject: [PATCH] Wait up to 60 s for a lit display when KMS capture is asked
 for, since Sunshine starts at boot before the compositor's first modeset


diff --git a/src/platform/linux/misc.cpp b/src/platform/linux/misc.cpp
index 9e2d2a7c..302e6c68 100644
--- a/src/platform/linux/misc.cpp
+++ b/src/platform/linux/misc.cpp
@@ -17,6 +17,7 @@
 #include <cerrno>
 #include <cstring>
 #include <fstream>
+#include <thread>
 #include <iomanip>
 #include <iostream>
 #include <sstream>
@@ -1493,6 +1494,17 @@ namespace platf {
     if (((selected_capture.empty() && sources.none()) || selected_capture == "kms") && verify_kms()) {
       sources[source::KMS] = true;
     }
+    // VaporOS: Sunshine starts at boot next to the compositor, often before its
+    // first modeset, when no plane is lit yet. Capture is set up only once, so
+    // when KMS was asked for explicitly, wait for a lit display instead of
+    // failing every stream until Sunshine is restarted.
+    if (selected_capture == "kms" && !sources[source::KMS]) {
+      BOOST_LOG(info) << "Waiting up to 60 s for a lit display to capture with KMS"sv;
+      for (int i = 0; i < 60 && !sources[source::KMS]; i++) {
+        std::this_thread::sleep_for(1s);
+        sources[source::KMS] = verify_kms();
+      }
+    }
 #endif
 #ifdef SUNSHINE_BUILD_X11
     // We enumerate this capture backend regardless of other suitable sources,
