+int FFmpegVideoDecoder::receiveFrame(AVFrame* frame)
+{
+    if (m_Pyrowave != nullptr) {
+        if (m_PyrowaveFrame->buf[0] == nullptr) {
+            return AVERROR(EAGAIN);
+        }
+        av_frame_move_ref(frame, m_PyrowaveFrame);
+        return 0;
+    }
+
+    return avcodec_receive_frame(m_VideoDecoderCtx, frame);
+}
+
+bool FFmpegVideoDecoder::tryInitializePyrowave(PDECODER_PARAMETERS params)
+{
+#ifdef HAVE_PYROWAVE
+    bool yuv444 = (params->videoFormat & VIDEO_FORMAT_PYROWAVE_444) != 0;
+    AVPixelFormat format = yuv444 ? AV_PIX_FMT_YUV444P : AV_PIX_FMT_YUV420P;
+
+    // Renderers that take planar YUV frames from system memory, best first
+    std::vector<std::function<IFFmpegRenderer*()>> renderers;
+#ifdef Q_OS_DARWIN
+    renderers.push_back([]() -> IFFmpegRenderer* { return VTMetalRendererFactory::createRenderer(false); });
+#endif
+#ifdef HAVE_LIBPLACEBO_VULKAN
+    renderers.push_back([]() -> IFFmpegRenderer* { return new PlVkRenderer(); });
+#endif
+    renderers.push_back([]() -> IFFmpegRenderer* { return new SdlRenderer(); });
+
+    for (auto& createRenderer : renderers) {
+        SDL_assert(m_BackendRenderer == nullptr);
+        m_BackendRenderer = createRenderer();
+        if (m_BackendRenderer != nullptr &&
+                initializeRendererInternal(m_BackendRenderer, params) &&
+                m_BackendRenderer->isPixelFormatSupported(params->videoFormat, format)) {
+            m_Pyrowave = PyrowaveDecoder::create(params->width, params->height, yuv444);
+            if (m_Pyrowave == nullptr) {
+                // The decoder itself can't run here; no renderer will change that
+                reset();
+                return false;
+            }
+            m_PyrowaveFrame = av_frame_alloc();
+            if (m_PyrowaveFrame != nullptr &&
+                    completeInitialization(nullptr, format, params,
+                                           m_TestOnly ? TestMode::TestFrameOnly : TestMode::NoTesting,
+                                           false)) {
+                SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                            "%s decoder with renderer '%s'",
+                            m_Pyrowave->name(),
+                            m_FrontendRenderer->getRendererName());
+                return true;
+            }
+        }
+        reset();
+    }
+
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                 "No renderer can show PyroWave frames (%s)",
+                 yuv444 ? "YUV 4:4:4" : "YUV 4:2:0");
+#else
+    Q_UNUSED(params);
+    SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "This build has no PyroWave decoder");
+#endif
+    return false;
+}
