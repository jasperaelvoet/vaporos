diff --git a/app/streaming/video/pyrowave/pyrowavedecoder.h b/app/streaming/video/pyrowave/pyrowavedecoder.h
new file mode 100644
index 00000000..9489f639
--- /dev/null
+++ b/app/streaming/video/pyrowave/pyrowavedecoder.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+extern "C" {
+#include <libavutil/frame.h>
+}
+
+// Decodes PyroWave frames (VaporOS's intra-only wavelet codec) into planar
+// YUV AVFrames for FFmpegVideoDecoder's software-frame renderers. A Moonlight
+// frame carries one complete PyroWave frame: its 32x32 blocks each state
+// their own size, so the whole frame goes to the decoder in one call.
+//
+// macOS decodes with PyroWave's Metal port, everything else with its Vulkan
+// C API.
+class PyrowaveDecoder {
+public:
+    // Returns nullptr when this machine can't run the decoder.
+    static PyrowaveDecoder* create(int width, int height, bool yuv444);
+
+    virtual ~PyrowaveDecoder() {}
+
+    // Decodes one frame into out (which must be empty). Returns 0 on success.
+    virtual int decode(const uint8_t* data, size_t size, AVFrame* out) = 0;
+
+    virtual const char* name() = 0;
+};
diff --git a/app/streaming/video/pyrowave/pyrowavedecoder_metal.mm b/app/streaming/video/pyrowave/pyrowavedecoder_metal.mm
new file mode 100644
index 00000000..816bfae1
--- /dev/null
+++ b/app/streaming/video/pyrowave/pyrowavedecoder_metal.mm
@@ -0,0 +1,256 @@
+// PyroWave decoding with its Metal port (Apple silicon). Built without ARC,
+// like the rest of Moonlight's Objective-C++.
+
+#import <Metal/Metal.h>
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "SDL_compat.h"
+#include "pyrowavedecoder.h"
+
+#include <pyrowave_metal.h>
+
+extern "C" {
+#include <libavutil/buffer.h>
+#include <libavutil/pixfmt.h>
+}
+
+namespace {
+
+// One output frame: three planes in a single shared-storage buffer, which the
+// decoder writes through linear textures and the renderer reads as an AVFrame
+// without a copy. A slot is busy until the AVFrame that references it is freed.
+struct Slot {
+    id<MTLBuffer> buffer = nil;
+    id<MTLTexture> planes[3] = {nil, nil, nil};
+    size_t offsets[3] = {};
+    size_t strides[3] = {};
+    std::atomic<bool> busy{false};
+
+    ~Slot()
+    {
+        for (auto& t : planes) {
+            [t release];
+        }
+        [buffer release];
+    }
+};
+
+// Frames can outlive the decoder (Pacer frees its queue later), so each holds its slot.
+void releaseSlot(void* opaque, uint8_t*)
+{
+    auto* slot = static_cast<std::shared_ptr<Slot>*>(opaque);
+    (*slot)->busy = false;
+    delete slot;
+}
+
+size_t alignUp(size_t v, size_t a)
+{
+    return (v + a - 1) / a * a;
+}
+
+class PyrowaveMetalDecoder : public PyrowaveDecoder {
+public:
+    PyrowaveMetalDecoder(int width, int height, bool yuv444)
+        : m_Width(width), m_Height(height), m_Yuv444(yuv444) {}
+
+    ~PyrowaveMetalDecoder() override
+    {
+        if (m_Decoder) {
+            pyrowave_decoder_destroy(m_Decoder);
+        }
+        if (m_PwDevice) {
+            pyrowave_device_destroy(m_PwDevice);
+        }
+        m_Slots.clear();
+        [m_Queue release];
+        [m_Device release];
+    }
+
+    bool initialize()
+    {
+        uint32_t major, minor, patch;
+        pyrowave_get_api_version(&major, &minor, &patch);
+        if (major != PYROWAVE_API_VERSION_MAJOR) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                         "PyroWave: library API %u.%u does not match", major, minor);
+            return false;
+        }
+
+        m_Device = MTLCreateSystemDefaultDevice();
+        if (m_Device == nil || !pyrowave_device_is_supported((__bridge void*)m_Device)) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                        "PyroWave: this GPU can't run the Metal decoder (Apple silicon only)");
+            return false;
+        }
+        m_Queue = [m_Device newCommandQueue];
+
+        pyrowave_device_create_info dci = {};
+        dci.mtl_device = (__bridge void*)m_Device;
+        if (pyrowave_device_create(&dci, &m_PwDevice) != PYROWAVE_SUCCESS) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: pyrowave_device_create() failed");
+            return false;
+        }
+
+        pyrowave_decoder_create_info info = {};
+        info.device = m_PwDevice;
+        info.width = m_Width;
+        info.height = m_Height;
+        info.chroma = m_Yuv444 ? PYROWAVE_CHROMA_SUBSAMPLING_444 : PYROWAVE_CHROMA_SUBSAMPLING_420;
+        if (pyrowave_decoder_create(&info, &m_Decoder) != PYROWAVE_SUCCESS) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                         "PyroWave: pyrowave_decoder_create(%dx%d) failed", m_Width, m_Height);
+            return false;
+        }
+
+        // Linear textures need their rows and offsets aligned for the GPU; 64 also suits FFmpeg.
+        m_Align = qMaxAlign([m_Device minimumLinearTextureAlignmentForPixelFormat:MTLPixelFormatR8Unorm]);
+        return true;
+    }
+
+    const char* name() override
+    {
+        return "PyroWave (Metal)";
+    }
+
+    int decode(const uint8_t* data, size_t size, AVFrame* out) override
+    {
+        // Every Moonlight frame is a whole PyroWave frame, so start clean: the
+        // bitstream's 3-bit sequence counter can't order frames across losses.
+        pyrowave_decoder_clear(m_Decoder);
+        if (pyrowave_decoder_push_packet(m_Decoder, data, size) != PYROWAVE_SUCCESS) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: corrupt frame (%zu bytes)", size);
+            return -1;
+        }
+        if (!pyrowave_decoder_decode_is_ready(m_Decoder, false) && !m_WarnedPartial) {
+            // Missing blocks decode as blur; it should not happen with complete Moonlight frames.
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: decoding an incomplete frame");
+            m_WarnedPartial = true;
+        }
+
+        std::shared_ptr<Slot> slot = acquireSlot();
+        if (!slot) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: no free output buffer, dropping a frame");
+            return -1;
+        }
+
+        @autoreleasepool {
+            id<MTLCommandBuffer> cmd = [m_Queue commandBuffer];
+            pyrowave_gpu_buffers buffers = {};
+            for (int i = 0; i < 3; i++) {
+                buffers.planes[i] = (__bridge void*)slot->planes[i];
+            }
+            if (pyrowave_decoder_decode_gpu_buffer(m_Decoder, (__bridge void*)cmd, &buffers) != PYROWAVE_SUCCESS) {
+                slot->busy = false;
+                SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: decode failed");
+                return -1;
+            }
+            [cmd commit];
+            [cmd waitUntilCompleted];
+            if (cmd.status != MTLCommandBufferStatusCompleted) {
+                slot->busy = false;
+                SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: GPU decode failed");
+                return -1;
+            }
+        }
+
+        uint8_t* base = static_cast<uint8_t*>(slot->buffer.contents);
+        out->format = m_Yuv444 ? AV_PIX_FMT_YUV444P : AV_PIX_FMT_YUV420P;
+        out->width = m_Width;
+        out->height = m_Height;
+        for (int i = 0; i < 3; i++) {
+            out->data[i] = base + slot->offsets[i];
+            out->linesize[i] = static_cast<int>(slot->strides[i]);
+        }
+        out->buf[0] = av_buffer_create(base, slot->buffer.length, releaseSlot,
+                                       new std::shared_ptr<Slot>(slot), AV_BUFFER_FLAG_READONLY);
+        if (!out->buf[0]) {
+            slot->busy = false;
+            return -1;
+        }
+        out->flags |= AV_FRAME_FLAG_KEY;
+        out->pict_type = AV_PICTURE_TYPE_I;
+        return 0;
+    }
+
+private:
+    static size_t qMaxAlign(size_t a)
+    {
+        return a > 64 ? a : 64;
+    }
+
+    std::shared_ptr<Slot> acquireSlot()
+    {
+        for (auto& s : m_Slots) {
+            bool expected = false;
+            if (s->busy.compare_exchange_strong(expected, true)) {
+                return s;
+            }
+        }
+        // Pacer holds up to 5 frames, the renderer 1 or 2, and one is being decoded.
+        if (m_Slots.size() >= 12) {
+            return nullptr;
+        }
+
+        auto slot = std::make_shared<Slot>();
+        int cw = m_Yuv444 ? m_Width : m_Width / 2;
+        int ch = m_Yuv444 ? m_Height : m_Height / 2;
+        int widths[3] = {m_Width, cw, cw};
+        int heights[3] = {m_Height, ch, ch};
+        size_t total = 0;
+        for (int i = 0; i < 3; i++) {
+            slot->strides[i] = alignUp(widths[i], m_Align);
+            slot->offsets[i] = total;
+            total = alignUp(total + slot->strides[i] * heights[i], m_Align);
+        }
+        slot->buffer = [m_Device newBufferWithLength:total options:MTLResourceStorageModeShared];
+        if (slot->buffer == nil) {
+            return nullptr;
+        }
+        for (int i = 0; i < 3; i++) {
+            MTLTextureDescriptor* desc =
+                [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR8Unorm
+                                                                   width:widths[i]
+                                                                  height:heights[i]
+                                                               mipmapped:NO];
+            desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+            desc.storageMode = MTLStorageModeShared;
+            slot->planes[i] = [slot->buffer newTextureWithDescriptor:desc
+                                                              offset:slot->offsets[i]
+                                                         bytesPerRow:slot->strides[i]];
+            if (slot->planes[i] == nil) {
+                return nullptr;
+            }
+        }
+        slot->busy = true;
+        m_Slots.push_back(slot);
+        return slot;
+    }
+
+    int m_Width;
+    int m_Height;
+    bool m_Yuv444;
+    size_t m_Align = 64;
+    bool m_WarnedPartial = false;
+
+    id<MTLDevice> m_Device = nil;
+    id<MTLCommandQueue> m_Queue = nil;
+    pyrowave_device m_PwDevice = nullptr;
+    pyrowave_decoder m_Decoder = nullptr;
+    std::vector<std::shared_ptr<Slot>> m_Slots;
+};
+
+}
+
+PyrowaveDecoder* PyrowaveDecoder::create(int width, int height, bool yuv444)
+{
+    auto* decoder = new PyrowaveMetalDecoder(width, height, yuv444);
+    if (!decoder->initialize()) {
+        delete decoder;
+        return nullptr;
+    }
+    return decoder;
+}
diff --git a/app/streaming/video/pyrowave/pyrowavedecoder_vulkan.cpp b/app/streaming/video/pyrowave/pyrowavedecoder_vulkan.cpp
new file mode 100644
index 00000000..6bdef3a3
--- /dev/null
+++ b/app/streaming/video/pyrowave/pyrowavedecoder_vulkan.cpp
@@ -0,0 +1,117 @@
+// PyroWave decoding with its Vulkan C API (Windows and Linux). The frame is
+// read back to system memory for the software-frame renderers.
+
+#include <vulkan/vulkan.h>
+#include <pyrowave.h>
+
+#include "SDL_compat.h"
+#include "pyrowavedecoder.h"
+
+extern "C" {
+#include <libavutil/pixfmt.h>
+}
+
+namespace {
+
+class PyrowaveVulkanDecoder : public PyrowaveDecoder {
+public:
+    PyrowaveVulkanDecoder(int width, int height, bool yuv444)
+        : m_Width(width), m_Height(height), m_Yuv444(yuv444) {}
+
+    ~PyrowaveVulkanDecoder() override
+    {
+        if (m_Decoder) {
+            pyrowave_decoder_destroy(m_Decoder);
+        }
+        if (m_Device) {
+            pyrowave_device_destroy(m_Device);
+        }
+    }
+
+    bool initialize()
+    {
+        uint32_t major, minor, patch;
+        pyrowave_get_api_version(&major, &minor, &patch);
+        if (major != PYROWAVE_API_VERSION_MAJOR) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                         "PyroWave: library API %u.%u does not match", major, minor);
+            return false;
+        }
+        if (pyrowave_create_default_device(&m_Device) != PYROWAVE_SUCCESS) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: no usable Vulkan device");
+            return false;
+        }
+
+        pyrowave_decoder_create_info info = {};
+        info.device = m_Device;
+        info.width = m_Width;
+        info.height = m_Height;
+        info.chroma = m_Yuv444 ? PYROWAVE_CHROMA_SUBSAMPLING_444 : PYROWAVE_CHROMA_SUBSAMPLING_420;
+        info.fragment_path = pyrowave_decoder_device_prefers_fragment_path(m_Device);
+        if (pyrowave_decoder_create(&info, &m_Decoder) != PYROWAVE_SUCCESS) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                         "PyroWave: pyrowave_decoder_create(%dx%d) failed", m_Width, m_Height);
+            return false;
+        }
+        return true;
+    }
+
+    const char* name() override
+    {
+        return "PyroWave (Vulkan)";
+    }
+
+    int decode(const uint8_t* data, size_t size, AVFrame* out) override
+    {
+        pyrowave_decoder_clear(m_Decoder);
+        if (pyrowave_decoder_push_packet(m_Decoder, data, size) != PYROWAVE_SUCCESS) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: corrupt frame (%zu bytes)", size);
+            return -1;
+        }
+
+        out->format = m_Yuv444 ? AV_PIX_FMT_YUV444P : AV_PIX_FMT_YUV420P;
+        out->width = m_Width;
+        out->height = m_Height;
+        if (av_frame_get_buffer(out, 64) < 0) {
+            return -1;
+        }
+
+        int ch = m_Yuv444 ? m_Height : m_Height / 2;
+        pyrowave_cpu_buffer buf = {};
+        for (int i = 0; i < 3; i++) {
+            buf.data[i] = out->data[i];
+            buf.row_stride_in_bytes[i] = out->linesize[i];
+            buf.plane_size_in_bytes[i] = (size_t)out->linesize[i] * (i ? ch : m_Height);
+        }
+        buf.width = m_Width;
+        buf.height = m_Height;
+        buf.format = m_Yuv444 ? PYROWAVE_CPU_BUFFER_FORMAT_YUV444P : PYROWAVE_CPU_BUFFER_FORMAT_YUV420P;
+        if (pyrowave_decoder_decode_cpu_buffer_synchronous(m_Decoder, &buf) != PYROWAVE_SUCCESS) {
+            av_frame_unref(out);
+            SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "PyroWave: decode failed");
+            return -1;
+        }
+        out->flags |= AV_FRAME_FLAG_KEY;
+        out->pict_type = AV_PICTURE_TYPE_I;
+        return 0;
+    }
+
+private:
+    int m_Width;
+    int m_Height;
+    bool m_Yuv444;
+    pyrowave_device m_Device = nullptr;
+    pyrowave_decoder m_Decoder = nullptr;
+};
+
+}
+
+PyrowaveDecoder* PyrowaveDecoder::create(int width, int height, bool yuv444)
+{
+    auto* decoder = new PyrowaveVulkanDecoder(width, height, yuv444);
+    if (!decoder->initialize()) {
+        delete decoder;
+        return nullptr;
+    }
+    return decoder;
+}
