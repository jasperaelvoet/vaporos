From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jasper Aelvoet <jasper.aelvoet@me.com>
Date: Mon, 23 Nov 2026 23:32:50 +0100
Subject: [PATCH] Add the PyroWave codec (VaporOS): Metal and Vulkan decoders
 behind FFmpegVideoDecoder, and a codec choice


diff --git a/app/app.pro b/app/app.pro
index 1c0661b3..e4ba6d21 100644
--- a/app/app.pro
+++ b/app/app.pro
@@ -415,6 +415,49 @@ macx {
     HEADERS += \
         streaming/video/ffmpeg-renderers/vt.h
 }
+# VaporOS: the PyroWave decoder. PYROWAVE_DIR is an install prefix holding
+# lib/ and include/pyrowave/ of pyrowave-metal (macOS) or pyrowave-shared
+# (Windows, Linux); on Linux pkg-config's pyrowave-shared works as well.
+# It may also come from the environment, for the upstream build scripts.
+isEmpty(PYROWAVE_DIR) {
+    PYROWAVE_DIR = $$(PYROWAVE_DIR)
+}
+!isEmpty(PYROWAVE_DIR) {
+    CONFIG += pyrowave
+}
+unix:!macx:isEmpty(PYROWAVE_DIR) {
+    packagesExist(pyrowave-shared) {
+        CONFIG += pyrowave
+    }
+}
+pyrowave {
+    message(PyroWave decoder enabled)
+
+    DEFINES += HAVE_PYROWAVE
+    HEADERS += streaming/video/pyrowave/pyrowavedecoder.h
+
+    macx {
+        INCLUDEPATH += $$PYROWAVE_DIR/include/pyrowave
+        LIBS += -L$$PYROWAVE_DIR/lib -lpyrowave-metal -framework IOSurface
+        SOURCES += streaming/video/pyrowave/pyrowavedecoder_metal.mm
+
+        PYROWAVE_BUNDLE.files = $$PYROWAVE_DIR/lib/libpyrowave-metal.1.dylib
+        PYROWAVE_BUNDLE.path = Contents/Frameworks
+        QMAKE_BUNDLE_DATA += PYROWAVE_BUNDLE
+        QMAKE_RPATHDIR += @executable_path/../Frameworks
+    }
+    else {
+        isEmpty(PYROWAVE_DIR) {
+            PKGCONFIG += pyrowave-shared
+        }
+        else {
+            # include/ may also hold the Vulkan headers pyrowave.h needs
+            INCLUDEPATH += $$PYROWAVE_DIR/include/pyrowave $$PYROWAVE_DIR/include
+            LIBS += -L$$PYROWAVE_DIR/lib -lpyrowave-shared
+        }
+        SOURCES += streaming/video/pyrowave/pyrowavedecoder_vulkan.cpp
+    }
+}
 discord-rpc {
     message(Discord integration enabled)
 
