{
  "schema": 1,
  "direction": "redline",
  "targets": ["tv", "web"],
  "modes": { "web": ["dark"], "site": ["dark"], "tv": ["tv"] },
  "theme": { "default": "dark", "switch": false },
  "app": {
    "name": "VaporOS",
    "shortName": "VaporOS",
    "description": "Manage your VaporOS game streaming PC."
  },
  "palette": {
    "ash":       { "hex": "#0b0a0c", "use": "page" },
    "soot":      { "hex": "#151217", "use": "panels, rows" },
    "char":      { "hex": "#211c23", "use": "raised and pressed" },
    "line":      { "hex": "#2e2730", "use": "rules" },
    "bone":      { "hex": "#f3eee7", "use": "text" },
    "smoke":     { "hex": "#a69ca4", "use": "secondary text, the OS of the wordmark" },
    "dim":       { "hex": "#8a808e", "use": "tertiary text" },
    "cold":      { "hex": "#7fd6ff", "use": "fault: below the scale, always with hazard tape and words" },
    "ink-ready": { "hex": "#c58bd3", "use": "ready as text, step numbers" },
    "hot-ink":   { "hex": "#2a2230", "use": "body text on white-hot" },
    "hot-ink-2": { "hex": "#4a3f4f", "use": "meta text on white-hot, the OS of the wordmark on light" }
  },
  "ramp": {
    "heat": {
      "prefix": "h",
      "use": "Matplotlib's Inferno at ten stops: asleep, cold boot, idle, ready, ready's peak, restart needed, warm load, streaming, hot, white-hot",
      "stops": ["#000004", "#1b0c41", "#4a0c6b", "#781c6d", "#a52c60", "#cf4446", "#ed6925", "#fb9b06", "#f7d13d", "#fcffa4"]
    },
    "cold": {
      "prefix": "c",
      "use": "the fault map: the heat ramp's lightness steps, below the scale",
      "stops": ["#000004", "#020a1c", "#06193a", "#0c2e5a", "#17497d", "#2a69a0", "#4a8ec4", "#7fd6ff", "#bfebff", "#e8f8ff"]
    }
  },
  "color": {
    "canvas":      { "dark": "ash", "tv": "h0" },
    "canvas-2":    { "dark": "h0", "tv": "#0a051b" },
    "surface":     { "dark": "soot", "tv": "ash" },
    "surface-2":   { "dark": "char", "tv": "soot" },
    "line":        { "dark": "line" },
    "line-strong": { "dark": "dim" },
    "ink":         { "dark": "bone" },
    "ink-2":       { "dark": "smoke" },
    "ink-3":       { "dark": "dim" },
    "accent":      { "dark": "h9" },
    "accent-ink":  { "dark": "ash" },
    "focus":       { "dark": "h9" },
    "danger":      { "dark": "cold" },
    "danger-ink":  { "dark": "ash" }
  },
  "state": {
    "ready": {
      "label": "Ready", "color": { "dark": "ink-ready" }, "ink": { "dark": "ash" }, "soft": { "dark": "#291f2c" },
      "motion": "steady", "reduced": "steady", "signage": "ready",
      "look": { "heat": 0.42, "cut": "warm", "from": 0.74, "map": "heat", "reach": 150, "peak": 0.45 }
    },
    "streaming": {
      "label": "Streaming", "color": { "dark": "h7" }, "ink": { "dark": "ash" }, "soft": { "dark": "#31210b" },
      "motion": "pip", "reduced": "steady", "signage": "streaming",
      "look": { "heat": 0.87, "cut": "hot", "from": 0.62, "map": "heat", "reach": 320, "peak": 0.98 }
    },
    "updating": {
      "label": "Updating", "color": { "dark": "h8" }, "ink": { "dark": "ash" }, "soft": { "dark": "#312a14" },
      "motion": "fill", "reduced": "steady", "signage": "updating",
      "look": { "heat": 0.55, "cut": "warm", "from": 0.74, "map": "heat", "reach": 240, "peak": 0.74 }
    },
    "restart-needed": {
      "label": "Restart needed", "color": { "dark": "h8" }, "ink": { "dark": "ash" }, "soft": { "dark": "#312a14" },
      "motion": "steady", "reduced": "steady", "signage": "restart needed",
      "look": { "heat": 0.6, "cut": "warm", "from": 0.74, "map": "heat", "reach": 210, "peak": 0.66 }
    },
    "asleep": {
      "label": "Asleep", "color": { "dark": "smoke" }, "ink": { "dark": "ash" }, "soft": { "dark": "#242124" },
      "motion": "steady", "reduced": "steady", "signage": "asleep",
      "look": { "heat": 0.05, "cut": "cold", "from": 1.34, "map": "heat", "reach": 100, "peak": 0.15 }
    },
    "fault": {
      "label": "Needs attention", "color": { "dark": "cold" }, "ink": { "dark": "ash" }, "soft": { "dark": "#1e2b33" },
      "motion": "steady", "reduced": "steady", "signage": "fault",
      "look": { "heat": 0, "cut": "warm", "from": 1, "map": "cold", "reach": 190, "peak": 0.7 }
    },
    "installing": {
      "label": "Installing", "color": { "dark": "ink-ready" }, "ink": { "dark": "ash" }, "soft": { "dark": "#291f2c" },
      "motion": "fill", "reduced": "steady", "signage": "setting up",
      "look": { "heat": 0.2, "cut": "cold", "from": 1.34, "map": "heat", "reach": 118, "peak": 0.42 }
    }
  },
  "neutral": {
    "label": "", "color": { "dark": "dim" }, "ink": { "dark": "ash" }, "soft": { "dark": "#1a181c" },
    "motion": "steady", "reduced": "steady", "signage": "",
    "look": { "heat": 0.3, "cut": "cold", "from": 1.34, "map": "heat", "reach": 118, "peak": 0.3 }
  },
  "attention": {
    "pair": {
      "label": "Pairing", "color": { "dark": "ink-ready" }, "ink": { "dark": "ash" }, "soft": { "dark": "#291f2c" },
      "motion": "steps", "reduced": "steady", "signage": "pairing",
      "look": { "heat": 0.5, "cut": "warm", "from": 0.74, "map": "heat", "reach": 220, "peak": 0.7 }
    }
  },
  "contrast": [
    { "fg": ["ink", "ink-2"], "bg": ["canvas", "canvas-2", "surface", "surface-2"], "min": 4.5, "why": "text on every ground" },
    { "fg": ["ink-3"], "bg": ["canvas", "surface"], "min": 4.5, "why": "tertiary text never sits on surface-2 (dim on char is 4.43)" },
    { "fg": ["line-strong"], "bg": ["surface", "surface-2"], "min": 3, "why": "control boundaries" },
    { "fg": ["accent-ink"], "bg": ["accent"], "min": 4.5, "why": "primary buttons, the download block" },
    { "fg": ["danger-ink"], "bg": ["danger"], "min": 4.5, "why": "Power off and Unpair confirm" },
    { "fg": ["danger"], "bg": ["canvas", "surface"], "min": 4.5, "why": "the fault tag and ink" },
    { "fg": ["focus"], "bg": ["canvas", "surface", "surface-2"], "min": 3, "why": "the 2 px white-hot focus ring" },
    { "fg": ["state.*.ink"], "bg": ["state.*.color"], "min": 4.5, "why": "text on a filled state chip" },
    { "fg": ["state.*.color"], "bg": ["canvas", "surface"], "min": 4.5, "why": "REDLINE sets state words in the state colour" },
    { "fg": ["ink"], "bg": ["state.*.soft"], "min": 4.5, "why": "text on a state tint" },
    { "fg": ["state.*.color"], "bg": ["state.*.soft"], "min": 4.5, "why": "a state word on its own tint" },
    { "fg": ["ink"], "bg": ["h1", "h2", "h3", "h4"], "min": 4.5, "why": "PIN slots heating one step per digit; TV status on the cool side" },
    { "fg": ["canvas", "hot-ink", "hot-ink-2"], "bg": ["accent"], "min": 4.5, "why": "text on white-hot" },
    { "fg": ["canvas"], "bg": ["h7", "h8"], "min": 4.5, "why": "the HDR tag" },
    { "fg": ["ink", "ink-2"], "bg": ["c2"], "min": 4.5, "why": "TV fault status and detail over the cold field" },
    { "fg": ["handshake.on"], "bg": ["handshake.ground"], "min": 3, "why": "the handshake mark's cells" }
  ],
  "font": {
    "display": {
      "family": "Anybody",
      "fallback": ["Arial Narrow", "Helvetica Neue", "Arial", "sans-serif"],
      "faces": {
        "cold": { "wdth": 72, "wght": 560 },
        "warm": { "wdth": 100, "wght": 700 },
        "hot":  { "wdth": 124, "wght": 800 }
      }
    },
    "ui": {
      "family": "Mona Sans",
      "fallback": ["-apple-system", "Segoe UI", "system-ui", "sans-serif"],
      "faces": {
        "regular":  { "wdth": 100, "wght": 400 },
        "semibold": { "wdth": 100, "wght": 600 }
      }
    },
    "mono": {
      "family": "Martian Mono",
      "fallback": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"],
      "features": "\"tnum\" 1",
      "faces": {
        "medium":   { "wdth": 100, "wght": 500 },
        "semibold": { "wdth": 100, "wght": 600 }
      }
    }
  },
  "text": {
    "2xs":      { "size": "0.6875rem", "leading": "1rem" },
    "xs":       { "size": "0.75rem", "leading": "1rem" },
    "sm":       { "size": "0.8125rem", "leading": "1.125rem" },
    "md":       { "size": "0.875rem", "leading": "1.25rem" },
    "base":     { "size": "0.9375rem", "leading": "1.375rem" },
    "lg":       { "size": "1.0625rem", "leading": "1.625rem" },
    "xl":       { "size": "1.375rem", "leading": "1.75rem" },
    "2xl":      { "size": "1.875rem", "leading": "2.125rem", "tracking": "-0.01em" },
    "title":    { "size": "2.75rem", "leading": "1", "tracking": "-0.015em" },
    "title-lg": { "size": "3.5rem", "leading": "1", "tracking": "-0.015em" },
    "hero":     { "size": "clamp(2.75rem, 14vw, 4.75rem)", "leading": "0.92", "tracking": "-0.02em" }
  },
  "radius": {
    "xs": "2px", "sm": "4px", "md": "6px", "lg": "12px", "xl": "14px", "2xl": "16px", "3xl": "22px", "pill": "9999px"
  },
  "spacing": { "base": "0.25rem", "named": { "gutter": "1rem", "target": "2.75rem" } },
  "breakpoint": { "rail": "64rem" },
  "motion": {
    "duration": {
      "instant": 80, "fast": 180, "base": 250, "toast": 300, "release": 350, "shake": 360, "slow": 380,
      "fire": 450, "step": 450, "heat": 600, "pct": 800, "stretch": 900, "needle": 900, "count": 1100, "cool": 1400
    },
    "ease": {
      "standard": "cubic-bezier(.22,1,.36,1)",
      "out": "cubic-bezier(.22,1,.36,1)",
      "sheet": "cubic-bezier(.32,.72,0,1)",
      "tach": "linear(0.000, 0.036, 0.126, 0.249, 0.387, 0.527, 0.659, 0.775, 0.873, 0.952, 1.011, 1.052, 1.078, 1.091, 1.095, 1.091, 1.082, 1.070, 1.057, 1.043, 1.031, 1.020, 1.011, 1.004, 0.998, 0.995, 0.992, 0.991, 0.991, 0.991, 1)",
      "width": "linear(0.000, 0.071, 0.222, 0.394, 0.554, 0.689, 0.793, 0.870, 0.924, 0.960, 0.982, 0.995, 1.002, 1.005, 1.006, 1.006, 1.005, 1.004, 1.003, 1.002, 1)"
    },
    "spring": {
      "tach":  { "zeta": 0.6, "hz": 1.35 },
      "width": { "zeta": 0.85, "hz": 1.35 }
    },
    "pattern": {
      "steady": {},
      "fill": {},
      "pip": { "periodMs": 2400 },
      "steps": { "stepMs": 180 }
    },
    "hold": { "ms": 1200, "releaseMs": 350, "fireMs": 450, "nudgeMs": 2800 },
    "scene": { "coolMs": 2600, "heatMs": 2600 }
  },
  "filter": {
    "turbulence": { "baseFrequency": ".011 .015", "octaves": 2, "seed": 11, "scale": 34, "blur": 0.7 },
    "maps": {
      "f-heat": { "ramp": "heat", "bands": 12, "sub": 10, "line": 0.66 },
      "f-cold": { "ramp": "cold", "bands": 12, "sub": 10, "line": 0.66 }
    }
  },
  "handshake": {
    "on": ["h6", "h7", "h8", "h9", "ink-ready"],
    "ground": ["h0", "h1", "h2"]
  },
  "tv": {
    "reference": { "landscape": [1920, 1080], "portrait": [1080, 1920] },
    "safeInset": 0.05,
    "type": {
      "wordmark":       { "font": "display", "face": "hot", "px": 46 },
      "wordmarkAccent": { "font": "display", "face": "cold", "px": 46 },
      "version":        { "font": "mono", "face": "medium", "px": 22 },
      "scale":          { "font": "mono", "face": "medium", "px": 20 },
      "scaleLabel":     { "font": "mono", "face": "semibold", "px": 22 },
      "status":         { "font": "display", "face": "state", "px": 128, "portraitPx": 112 },
      "detail":         { "font": "ui", "face": "regular", "px": 42 },
      "url":            { "font": "mono", "face": "medium", "px": 74 },
      "ip":             { "font": "mono", "face": "medium", "px": 38 },
      "ipPrefix":       { "font": "ui", "face": "regular", "px": 38 },
      "codeLabel":      { "font": "ui", "face": "regular", "px": 30 },
      "code":           { "font": "mono", "face": "semibold", "px": 104 },
      "caption":        { "font": "ui", "face": "regular", "px": 32 }
    },
    "qr": { "card": { "landscape": 560, "portrait": 590 }, "quietModules": 4, "dark": "ash", "light": "h9" },
    "look": {
      "background": "thermal",
      "signature": "spot-meter",
      "qrFrame": "white-hot",
      "params": {
        "grid": 8, "bands": 12, "warp": 70, "ambient": 0.05, "lineDark": 0.42, "cool": 2.2, "grain": 3.5,
        "plateAlpha": 0.86, "textPlateAlpha": 0.9, "maxTextBand": 2
      }
    }
  },
  "labels": {
    "tv": {
      "codeLabel": "Setup code",
      "qrCaption": "Scan to open",
      "versionPrefix": "",
      "installerPrefix": "installer",
      "starting": "Starting…",
      "scaleCold": "asleep",
      "scaleHot": "streaming"
    }
  }
}
